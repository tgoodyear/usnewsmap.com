<!-- Result template: one output file, result.json, at most 8 MiB. -->
<output_template>
    <file_info>
        <name><OUTFILE_0/></name>
        <generated_locally/>
        <upload_when_present/>
        <max_nbytes>8388608</max_nbytes>
        <url><UPLOAD_URL/></url>
    </file_info>
    <result>
        <file_ref>
            <file_name><OUTFILE_0/></file_name>
            <open_name>result.json</open_name>
            <copy_file/>
        </file_ref>
    </result>
</output_template>
