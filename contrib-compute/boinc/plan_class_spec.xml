<?xml version="1.0"?>
<!-- Plan class for the Docker-wrapper app version that scripts/boinc/install.py (PR #441)
     installs under apps/usnm_ocr/<version>/<platform>__docker. The class name must be
     `docker`. The scheduler sends the version only to hosts that report a Docker install
     (src:sched/plan_class_spec.cpp); the server itself never runs Docker.
     Copy this to <project>/plan_class_spec.xml, or merge it into the sample from the BOINC
     release in use. See docs/verified-facts.md (d). -->
<plan_classes>
    <plan_class>
        <name>docker</name>
        <docker/>
        <!-- 8.2.11 is the recommended Mac client and already supports Run_Podman.
             8.2.12/13 are Linux hotfixes, not Mac container prerequisites. -->
        <min_core_client_version>80211</min_core_client_version>
    </plan_class>
    <!-- usnm_surya (#516, docs/boinc-surya.md). CPU: 4 to 8 threads; the scheduler reserves them
         and the stock docker_wrapper passes them to the container as cpus. Hosts with fewer than
         4 usable CPUs get no CPU version. -->
    <plan_class>
        <name>docker_mt</name>
        <docker/>
        <min_core_client_version>80213</min_core_client_version>
        <min_ncpus>4</min_ncpus>
        <max_threads>8</max_threads>
    </plan_class>
    <!-- usnm_surya on an NVIDIA GPU. The scheduler checks the GPU the client detected (CUDA,
         driver, memory); it can't check that Docker or Podman can pass it into a container, which
         is what the probe finds out. The version's job.toml sets use_gpu, so docker_wrapper runs
         the container with gpus all, and passes avg_ncpus as cpus. 2.5 GB of GPU memory: the
         model and projector are 1.5 GB, plus a 16k-token context. Two CPUs for Python and
         llama-server's host threads; BOINC's default GPU estimate otherwise, to tune from the
         probe. -->
    <plan_class>
        <name>docker_nvidia_cuda</name>
        <docker/>
        <gpu_type>nvidia</gpu_type>
        <cuda/>
        <min_core_client_version>80213</min_core_client_version>
        <min_cuda_version>12000</min_cuda_version>
        <min_nvidia_compcap>500</min_nvidia_compcap>
        <min_gpu_ram_mb>3000</min_gpu_ram_mb>
        <gpu_ram_used_mb>2500</gpu_ram_used_mb>
        <avg_ncpus>2</avg_ncpus>
    </plan_class>
    <!-- New classes keep legacy dual-model app versions out of split-payload work. -->
    <plan_class>
        <name>docker_mt_2b</name>
        <docker/>
        <min_core_client_version>80213</min_core_client_version>
        <min_ncpus>4</min_ncpus>
        <max_threads>8</max_threads>
        <min_batch>12</min_batch>
        <max_batch>12</max_batch>
    </plan_class>
    <!-- Model-specific Qwen GPU container (#559): no bundled 2B fallback.
         Other applications retain docker_nvidia_cuda and its smaller GPU requirement. -->
    <plan_class>
        <name>docker_nvidia_cuda_8b</name>
        <docker/>
        <gpu_type>nvidia</gpu_type>
        <cuda/>
        <min_core_client_version>80213</min_core_client_version>
        <min_cuda_version>12000</min_cuda_version>
        <min_nvidia_compcap>600</min_nvidia_compcap>
        <min_gpu_ram_mb>7000</min_gpu_ram_mb>
        <gpu_ram_used_mb>6500</gpu_ram_used_mb>
        <min_batch>18</min_batch>
        <max_batch>18</max_batch>
        <avg_ncpus>2</avg_ncpus>
    </plan_class>
    <!-- Bounded independent BF16 LoRA trials. No CPU fallback or float-byte consensus. -->
    <plan_class>
        <name>docker_nvidia_train</name>
        <docker/>
        <gpu_type>nvidia</gpu_type>
        <cuda/>
        <min_core_client_version>80213</min_core_client_version>
        <min_cuda_version>12080</min_cuda_version>
        <min_nvidia_compcap>800</min_nvidia_compcap>
        <min_gpu_ram_mb>15360</min_gpu_ram_mb>
        <gpu_ram_used_mb>15360</gpu_ram_used_mb>
        <avg_ncpus>2</avg_ncpus>
    </plan_class>
    <!-- Native plan classes for usnm_qwen (#533): no Docker/Podman required. -->
    <plan_class>
        <name>mt</name>
        <min_core_client_version>80213</min_core_client_version>
        <min_ncpus>4</min_ncpus>
        <max_threads>8</max_threads>
    </plan_class>
    <!-- Apple Silicon Metal GPU class for usnm_qwen (#533). Upstream sched/plan_class_spec.cpp
         checks gpu_type == "apple" for device eligibility and gpu_type == "apple_gpu" when
         assigning PROC_TYPE_APPLE_GPU; scripts/boinc/patch-server-apple-gpu.py patches both
         branches in contrib-compute/images/base/Containerfile so the scheduler reserves the
         Apple GPU as well as matching the host's Metal device. -->
    <plan_class>
        <name>apple_gpu_8b</name>
        <gpu_type>apple</gpu_type>
        <min_core_client_version>80213</min_core_client_version>
        <min_gpu_ram_mb>8192</min_gpu_ram_mb>
        <gpu_ram_used_mb>6500</gpu_ram_used_mb>
        <min_batch>8</min_batch>
        <max_batch>8</max_batch>
        <avg_ncpus>2</avg_ncpus>
    </plan_class>
    <plan_class>
        <name>nvidia_cuda_8b</name>
        <!-- Closed until an operator opens one audited workunit; never an account flag. -->
        <min_wu_id>2</min_wu_id>
        <max_wu_id>1</max_wu_id>
        <gpu_type>nvidia</gpu_type>
        <cuda/>
        <!-- Native apps do not require a container runtime. -->
        <min_core_client_version>80211</min_core_client_version>
        <min_cuda_version>12040</min_cuda_version>
        <min_nvidia_compcap>600</min_nvidia_compcap>
        <min_gpu_ram_mb>7000</min_gpu_ram_mb>
        <gpu_ram_used_mb>6000</gpu_ram_used_mb>
        <min_batch>8</min_batch>
        <max_batch>8</max_batch>
        <avg_ncpus>2</avg_ncpus>
    </plan_class>
    <plan_class>
        <name>nvidia_cuda_2b</name>
        <min_wu_id>2</min_wu_id>
        <max_wu_id>1</max_wu_id>
        <gpu_type>nvidia</gpu_type>
        <cuda/>
        <min_core_client_version>80211</min_core_client_version>
        <min_cuda_version>12040</min_cuda_version>
        <min_nvidia_compcap>500</min_nvidia_compcap>
        <min_gpu_ram_mb>3000</min_gpu_ram_mb>
        <gpu_ram_used_mb>2500</gpu_ram_used_mb>
        <min_batch>2</min_batch>
        <max_batch>2</max_batch>
        <avg_ncpus>2</avg_ncpus>
    </plan_class>
</plan_classes>
