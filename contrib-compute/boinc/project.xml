<?xml version="1.0"?>
<!-- Input for BOINC's `xadd`: the OCR app, the assessment app (#456), the gold check (#462), the Surya 2 test (#516) and the OCR quality estimate's two apps (#522), one platform to start. See docs/interface.md.
     Add further <platform> entries (aarch64-unknown-linux-gnu, ...) when those builds exist. -->
<boinc>
    <app>
        <name>usnm_ocr</name>
        <user_friendly_name>usnewsmap OCR (Tesseract, one page per task)</user_friendly_name>
        <min_version>0</min_version>
        <deprecated>0</deprecated>
        <homogeneous_redundancy>0</homogeneous_redundancy>
        <weight>1</weight>
        <beta>0</beta>
        <target_nresults>1</target_nresults>
    </app>
    <app>
        <name>usnm_assess</name>
        <user_friendly_name>usnewsmap JP2 against IIIF JPEG OCR check (one page per task)</user_friendly_name>
        <min_version>0</min_version>
        <deprecated>0</deprecated>
        <homogeneous_redundancy>0</homogeneous_redundancy>
        <weight>1</weight>
        <beta>0</beta>
        <target_nresults>2</target_nresults>
    </app>
    <app>
        <name>usnm_gold</name>
        <user_friendly_name>usnewsmap OCR gold check (scores the host engine on public ground truth)</user_friendly_name>
        <min_version>0</min_version>
        <deprecated>0</deprecated>
        <homogeneous_redundancy>0</homogeneous_redundancy>
        <weight>1</weight>
        <beta>0</beta>
        <target_nresults>1</target_nresults>
    </app>
    <app>
        <name>usnm_surya</name>
        <user_friendly_name>usnewsmap Surya 2 OCR test (CPU and NVIDIA GPU, one page per task)</user_friendly_name>
        <min_version>0</min_version>
        <deprecated>0</deprecated>
        <homogeneous_redundancy>0</homogeneous_redundancy>
        <weight>1</weight>
        <beta>0</beta>
        <target_nresults>2</target_nresults>
    </app>
    <app>
        <name>usnm_quality</name>
        <user_friendly_name>usnewsmap OCR quality estimate (compares the texts of one page per task)</user_friendly_name>
        <min_version>0</min_version>
        <deprecated>0</deprecated>
        <homogeneous_redundancy>0</homogeneous_redundancy>
        <weight>1</weight>
        <beta>0</beta>
        <target_nresults>2</target_nresults>
    </app>
    <app>
        <name>usnm_qwen</name>
        <user_friendly_name>usnewsmap OCR readings with Qwen3-VL (CPU and NVIDIA GPU, one page per task)</user_friendly_name>
        <min_version>0</min_version>
        <deprecated>0</deprecated>
        <homogeneous_redundancy>0</homogeneous_redundancy>
        <weight>1</weight>
        <beta>0</beta>
        <target_nresults>2</target_nresults>
    </app>
    <platform>
        <name>x86_64-pc-linux-gnu</name>
        <user_friendly_name>Linux running on an AMD x86_64 or Intel EM64T CPU</user_friendly_name>
    </platform>
</boinc>
