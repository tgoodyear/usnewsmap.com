// MySQL flexible server, private access only, Burstable tier.
//
// Authentication gap: BOINC's daemons and PHP code connect with a static user and
// password from config.xml. Entra tokens last 5 to 60 minutes and BOINC cannot refresh
// them, so Entra auth is not usable. The password is generated by the bootstrap script,
// stored in Key Vault, and passed here at deployment time as a secure parameter.
// See docs/design.md, security.
//
// Unverified: BOINC's schema uses MyISAM for a few forum/profile tables, and the
// service supports InnoDB only. Check at the first dev deployment.
param name string
param location string
param subnetId string
param privateDnsZoneId string
param adminLogin string = 'usnmboincadmin'
@secure()
param adminPassword string
@description('Burstable B1ms is the plan; B2s if CPU credits run out (docs/design.md, section 6).')
param skuName string = 'Standard_B1ms'
param storageGb int = 20

resource server 'Microsoft.DBforMySQL/flexibleServers@2023-12-30' = {
  name: take('usnm-${name}-mysql-${uniqueString(resourceGroup().id, name)}', 63)
  location: location
  sku: { name: skuName, tier: 'Burstable' }
  properties: {
    version: '8.0.21'
    administratorLogin: adminLogin
    administratorLoginPassword: adminPassword
    storage: { storageSizeGB: storageGb, autoGrow: 'Enabled', iops: 360 }
    backup: { backupRetentionDays: 7, geoRedundantBackup: 'Disabled' }
    highAvailability: { mode: 'Disabled' }
    network: { delegatedSubnetResourceId: subnetId, privateDnsZoneResourceId: privateDnsZoneId }
  }
}

resource database 'Microsoft.DBforMySQL/flexibleServers/databases@2023-12-30' = {
  parent: server
  name: 'usnmocr'
  properties: { charset: 'utf8mb4', collation: 'utf8mb4_general_ci' }
}

// BOINC's server code cannot negotiate TLS with every client library; this is the
// unverified item 12 in the design doc. It is left ON (the default) until tested.
resource secureTransport 'Microsoft.DBforMySQL/flexibleServers/configurations@2023-12-30' = {
  parent: server
  name: 'require_secure_transport'
  properties: { value: 'ON', source: 'user-override' }
}

output host string = server.properties.fullyQualifiedDomainName
output databaseName string = database.name
