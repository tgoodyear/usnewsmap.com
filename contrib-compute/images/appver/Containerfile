# A signed BOINC app version, baked on the server image for the publish job
# (infra/boinc/main.bicep, publishJob; docs/app-release.md). scripts/boinc-app-release.sh builds
# it in ACR Tasks from a context it assembles:
#
#   src/                 installer, ocr/boinc/ and project.xml at the committed HEAD
#   wrapper-candidate/   verified Mac wrapper (empty for Linux)
#   sigs/<file>.sig      the signatures made on the signing host (nothing else comes back)
#   code_sign_public     the PUBLIC half of the code-signing key (env/<env>.json)
#   publish-appver.sh    this directory's publish script
#   check_appver.py      the signature checks (no orphan or missing .sig, version.xml complete,
#                        every .sig verified with crypt_prog against the public key)
#
# The version directory is staged again here, with the same install.py, wrapper and worker
# image as on the signing host, so it is byte for byte what was signed. Each file is checked
# against its signature with the public key (check_appver.py): any refusal fails the build.
ARG SERVER_IMAGE
FROM ${SERVER_IMAGE}
ARG KIND=container
ARG APP
ARG VERSION
ARG WORKER_IMAGE=""
ARG PLAN_CLASS=docker
ARG PLATFORM=x86_64-pc-linux-gnu
ARG WRAPPER_PATH=/usr/local/lib/usnm-boinc/docker_wrapper
ARG WRAPPER_SHA256=""
ARG WRAPPER_SOURCE_PIN=""
ARG BINARY_PATH=""
COPY src /opt/usnm-appver-build/appver-src
COPY sigs /opt/usnm-appver-build/sigs
COPY code_sign_public /opt/usnm-appver-build/code_sign_public
COPY publish-appver.sh /usr/local/lib/usnm-boinc/publish-appver.sh
COPY check_appver.py /opt/usnm-appver-build/check_appver.py
# The release script supplies a verified Mac/Linux-arm64/Windows wrapper or native binary here;
# only Linux x86_64 container releases use the server wrapper.
COPY wrapper-candidate /opt/usnm-appver-build/wrapper-candidate
COPY extra /opt/usnm-appver-build/extra
RUN set -eu; \
    p=/usr/local/lib/usnm-boinc/appver; \
    mkdir -p "$p"; touch "$p/config.xml"; \
    cp /opt/usnm-appver-build/appver-src/contrib-compute/boinc/project.xml "$p/project.xml"; \
    if [ "$KIND" = "native" ]; then \
      set -- --project "$p" --kind native --binary "$BINARY_PATH" \
        --version "$VERSION" --app "$APP" --plan-class "$PLAN_CLASS" --platform "$PLATFORM"; \
      for extra_dir in /opt/usnm-appver-build/extra /opt/usnm-appver-build/wrapper-candidate/extra; do \
        if [ -d "$extra_dir" ]; then \
          for f in "$extra_dir"/*; do \
            [ -f "$f" ] || continue; \
            set -- "$@" --extra-file "$(basename "$f")=$f"; \
          done; \
          break; \
        fi; \
      done; \
      python3 /opt/usnm-appver-build/appver-src/scripts/boinc/install.py "$@"; \
      if [ -n "$PLAN_CLASS" ]; then \
        d="$p/apps/$APP/$VERSION/${PLATFORM}__${PLAN_CLASS}"; \
      else \
        d="$p/apps/$APP/$VERSION/${PLATFORM}"; \
      fi; \
    else \
      if [ "$PLATFORM" != "x86_64-pc-linux-gnu" ]; then \
        test -n "$WRAPPER_PATH" && test "$WRAPPER_PATH" != "/usr/local/lib/usnm-boinc/docker_wrapper" && test -f "$WRAPPER_PATH"; \
        test -n "$WRAPPER_SHA256" && test -n "$WRAPPER_SOURCE_PIN" && test -f "$WRAPPER_SOURCE_PIN"; \
        case "$PLATFORM" in \
          aarch64-unknown-linux-gnu) checker=/opt/usnm-appver-build/appver-src/scripts/boinc/check-linux-wrapper.py ;; \
          windows_x86_64) checker=/opt/usnm-appver-build/appver-src/scripts/boinc/check-windows-wrapper.py ;; \
          arm64-apple-darwin|x86_64-apple-darwin) checker=/opt/usnm-appver-build/appver-src/scripts/boinc/check-mac-wrapper.py ;; \
          *) echo "unsupported container platform: $PLATFORM" >&2; exit 1 ;; \
        esac; \
        python3 "$checker" --wrapper "$WRAPPER_PATH" --platform "$PLATFORM" \
          --sha256 "$WRAPPER_SHA256" --source-pin "$WRAPPER_SOURCE_PIN"; \
      fi; \
      python3 /opt/usnm-appver-build/appver-src/scripts/boinc/install.py --project "$p" \
        --kind container --wrapper "$WRAPPER_PATH" --image "$WORKER_IMAGE" --version "$VERSION" \
        --app "$APP" --plan-class "$PLAN_CLASS" --platform "$PLATFORM"; \
      d="$p/apps/$APP/$VERSION/${PLATFORM}__${PLAN_CLASS}"; \
    fi; \
    rm "$p/config.xml"; \
    python3 /opt/usnm-appver-build/check_appver.py --kind "$KIND" --app "$APP" --platform "$PLATFORM" --version-dir "$d" --sigs /opt/usnm-appver-build/sigs --public-key /opt/usnm-appver-build/code_sign_public; \
    rm -rf /opt/usnm-appver-build; \
    chmod 0755 /usr/local/lib/usnm-boinc/publish-appver.sh
ENV APPVER_KIND=${KIND} APPVER_APP=${APP} APPVER_VERSION=${VERSION} APPVER_PLATFORM=${PLATFORM} APPVER_PLAN_CLASS=${PLAN_CLASS}
ENTRYPOINT ["/usr/local/lib/usnm-boinc/publish-appver.sh"]
CMD []
