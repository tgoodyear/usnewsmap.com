# A signed BOINC app version, baked on the server image for the publish job
# (infra/boinc/main.bicep, publishJob; docs/app-release.md). scripts/boinc-app-release.sh builds
# it in ACR Tasks from a context it assembles:
#
#   src/                 installer, ocr/boinc/ and project.xml at the committed HEAD
#   wrapper-candidate/   verified Mac wrapper (empty for Linux)
#   sigs/<file>.sig      the signatures made on the signing host (nothing else comes back)
#   code_sign_public     the PUBLIC half of the code-signing key (env/<env>.json)
#   publish-appver.sh    this directory's publish script
#   check_appver.py      the signature checks (no orphan or missing .sig, version.xml complete,
#                        every .sig verified with crypt_prog against the public key)
#
# The version directory is staged again here, with the same install.py, wrapper and worker
# image as on the signing host, so it is byte for byte what was signed. Each file is checked
# against its signature with the public key (check_appver.py): any refusal fails the build.
ARG SERVER_IMAGE
FROM ${SERVER_IMAGE}
ARG KIND=container
ARG APP
ARG VERSION
ARG WORKER_IMAGE=""
ARG PLAN_CLASS=docker
ARG PLATFORM=x86_64-pc-linux-gnu
ARG WRAPPER_PATH=/usr/local/lib/usnm-boinc/docker_wrapper
ARG BINARY_PATH=""
COPY src /tmp/appver-src
COPY sigs /tmp/sigs
COPY code_sign_public /tmp/code_sign_public
COPY publish-appver.sh /usr/local/lib/usnm-boinc/publish-appver.sh
COPY check_appver.py /tmp/check_appver.py
# The release script supplies a verified Mac/Linux-arm64 wrapper or native binary here;
# Linux x86_64 and Windows container releases use the server wrapper.
COPY wrapper-candidate /tmp/wrapper-candidate
RUN set -eu; \
    p=/usr/local/lib/usnm-boinc/appver; \
    mkdir -p "$p"; touch "$p/config.xml"; \
    cp /tmp/appver-src/contrib-compute/boinc/project.xml "$p/project.xml"; \
    if [ "$KIND" = "native" ]; then \
      extra_args=""; \
      if [ -d /tmp/wrapper-candidate/extra ]; then \
        extra_args="--bundle-dir /tmp/wrapper-candidate/extra"; \
      fi; \
      python3 /tmp/appver-src/scripts/boinc/install.py --project "$p" \
        --kind native --binary "$BINARY_PATH" $extra_args --version "$VERSION" \
        --app "$APP" --plan-class "$PLAN_CLASS" --platform "$PLATFORM"; \
      if [ -n "$PLAN_CLASS" ]; then \
        d="$p/apps/$APP/$VERSION/${PLATFORM}__${PLAN_CLASS}"; \
      else \
        d="$p/apps/$APP/$VERSION/${PLATFORM}"; \
      fi; \
    else \
      python3 /tmp/appver-src/scripts/boinc/install.py --project "$p" \
        --kind container --wrapper "$WRAPPER_PATH" --image "$WORKER_IMAGE" --version "$VERSION" \
        --app "$APP" --plan-class "$PLAN_CLASS" --platform "$PLATFORM"; \
      d="$p/apps/$APP/$VERSION/${PLATFORM}__${PLAN_CLASS}"; \
    fi; \
    rm "$p/config.xml"; \
    python3 /tmp/check_appver.py --kind "$KIND" --version-dir "$d" --sigs /tmp/sigs --public-key /tmp/code_sign_public; \
    rm -rf /tmp/appver-src /tmp/sigs /tmp/code_sign_public /tmp/check_appver.py /tmp/wrapper-candidate; \
    chmod 0755 /usr/local/lib/usnm-boinc/publish-appver.sh
ENV APPVER_KIND=${KIND} APPVER_APP=${APP} APPVER_VERSION=${VERSION} APPVER_PLATFORM=${PLATFORM} APPVER_PLAN_CLASS=${PLAN_CLASS}
ENTRYPOINT ["/usr/local/lib/usnm-boinc/publish-appver.sh"]
CMD []
