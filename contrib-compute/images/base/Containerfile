# The slow, rarely changing half of the BOINC server image: BOINC compiled from a pinned commit,
# the runtime packages, and docker_wrapper. scripts/build-boinc-images.sh tags it with a hash of
# this file and builds it only when that tag is missing, so the server image (our scripts and
# templates on top) rebuilds in about a minute.
#
# The BOINC commit is master, not the server_release/1.6/1.6.2 tag: that tag has no
# batch_collect_assimilator, which PR #441's daemons.xml runs (checked by grep of both trees on
# 2026-10-13). Move to the first release tag that has it, when one exists.
ARG BASE=mirror.gcr.io/library/debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587

FROM ${BASE} AS build
ARG BOINC_COMMIT=22bbebe08e2eaac5d5e88a6d93b88e800cb6341c
ARG BUILD_JOBS=2
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl dh-autoreconf g++ git libcurl4-gnutls-dev default-libmysqlclient-dev \
      libssl-dev libzip-dev libfmt-dev nlohmann-json3-dev m4 make pkg-config python3 python3-dev \
      python3-distutils python3-setuptools \
 && rm -rf /var/lib/apt/lists/*
COPY scripts/boinc/patch-server-apple-gpu.py /opt/usnm-build/patch-server-apple-gpu.py
COPY scripts/boinc/patch-server-db-tls.py /usr/local/lib/patch-server-db-tls.py
COPY scripts/boinc/patch-server-gold-routing.py scripts/boinc/gold-engine-routing.h /opt/usnm-build/
RUN git init /usr/local/boinc \
 && cd /usr/local/boinc \
 && git remote add origin https://github.com/BOINC/boinc.git \
 && git fetch --depth 1 origin "${BOINC_COMMIT}" \
 && git checkout --detach FETCH_HEAD \
 && test "$(git rev-parse HEAD)" = "${BOINC_COMMIT}" \
 && python3 /opt/usnm-build/patch-server-apple-gpu.py --source /usr/local/boinc/sched/plan_class_spec.cpp \
 && python3 /usr/local/lib/patch-server-db-tls.py --source /usr/local/boinc \
 && python3 /opt/usnm-build/patch-server-gold-routing.py --sched-dir /usr/local/boinc/sched \
 && cp /opt/usnm-build/gold-engine-routing.h /usr/local/boinc/sched/ \
 && rm -f /opt/usnm-build/patch-server-apple-gpu.py \
 && ./_autosetup \
 && ./configure --disable-client --disable-manager \
 && make -j "${BUILD_JOBS}" \
 && make -C api \
 && make -C samples/docker_wrapper \
 && rm -rf .git

FROM ${BASE}
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      apache2 ca-certificates curl default-mysql-client jq libapache2-mod-php8.2 libcurl3-gnutls \
      libfmt9 libmariadb3 libzip4 openssl php8.2-cli php8.2-curl php8.2-gd php8.2-mbstring \
      php8.2-mysql php8.2-xml procps python-is-python3 python3 python3-mysqldb python3-requests supervisor binutils \
 && a2dismod -q mpm_event && a2enmod -q mpm_prefork php8.2 cgi headers \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 1000 boincadm \
 && adduser www-data boincadm
COPY --from=build /usr/local/boinc /usr/local/boinc
# Azure's 2026 rotation requires BOTH roots. Use the maintained Debian trust
# package, not a network download during startup or a pinned leaf certificate.
COPY contrib-compute/images/base/mysql-tls.cnf /usr/local/share/usnm/mysql-tls.cnf
RUN cat /usr/share/ca-certificates/mozilla/DigiCert_Global_Root_G2.crt \
        /usr/share/ca-certificates/mozilla/Microsoft_RSA_Root_Certificate_Authority_2017.crt \
        > /usr/local/share/usnm/mysql-ca.pem \
 && test "$(grep -c 'BEGIN CERTIFICATE' /usr/local/share/usnm/mysql-ca.pem)" = 2 \
 && openssl verify -CAfile /usr/local/share/usnm/mysql-ca.pem \
        /usr/share/ca-certificates/mozilla/DigiCert_Global_Root_G2.crt \
        /usr/share/ca-certificates/mozilla/Microsoft_RSA_Root_Certificate_Authority_2017.crt
# The docker_wrapper that install.py (PR #441) puts in the signed app version: built here from the
# same pinned source, so the wrapper has the workdir and create_args settings job.toml needs.
# (the Makefile may add a release suffix to the binary's name, so find it)
RUN mkdir -p /usr/local/lib/usnm-boinc \
 && w="$(find /usr/local/boinc/samples/docker_wrapper -maxdepth 1 -type f -perm -u+x -name 'docker_wrapper*' | head -n 1)" \
 && test -n "$w" && cp "$w" /usr/local/lib/usnm-boinc/docker_wrapper
