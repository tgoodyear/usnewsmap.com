#!/bin/sh
# script_validator's compare script for usnm_quality (#522), called as
# `usnm_quality_compare files files2`: two results' files, three each, in output template order.
# Exit 0 when they agree (usnm-boinc quality compare: the same outcome and canonical records that
# are equal). Every pair is appended to <project>/quality/pairs.jsonl. Linked into bin/.
[ "$#" -eq 6 ] || { echo "usnm_quality_compare: expected 6 files, got $#" >&2; exit 2; }
exec /usr/local/bin/usnm-boinc quality compare --files "$1" "$2" "$3" --files2 "$4" "$5" "$6" \
  --log "${USNM_QUALITY_DIR:-$(cd .. && pwd)/quality}/pairs.jsonl"
