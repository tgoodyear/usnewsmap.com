# The bridge job image: the server image (the stock project tools, create_work, config rendering
# and /usr/local/bin/bridge-job) plus the usnm-boinc binary from the bridge-bin image. The binary comes
# in by reference; this build copies it and the assessment scripts.
#
#   docker build -f contrib-compute/images/bridge/Containerfile \
#     --build-arg SERVER_IMAGE=REGISTRY/usnm-boinc-server@sha256:... \
#     --build-arg BIN_IMAGE=REGISTRY/usnm-boinc-bridge-bin:<tag> .   (context: the repository)
ARG SERVER_IMAGE
ARG BIN_IMAGE
FROM ${BIN_IMAGE} AS bin

FROM ${SERVER_IMAGE}
# Debian security updates at build time (#969): the image this builds on is pinned, so its
# packages are frozen at whatever it was built with. A new SECURITY_REFRESH (a date) makes a
# cached build run this layer again. PHP_FLOOR and APACHE_FLOOR are the oldest php8.2 and
# apache2 the image may ship: DSA-6255-1 (CVE-2026-109618, CVE-2026-109619, 21 October 2026)
# and DSA-6323-1 (CVE-2026-49975, 6 June 2026). The build fails below either; raise it after
# the next PHP or Apache DSA, here, in the other Containerfiles and in
# scripts/boinc/onprem/usnm-image-security-check.service.
ARG SECURITY_REFRESH=2026-10-21
ARG PHP_FLOOR=8.2.35-1~deb12u1
ARG APACHE_FLOOR=2.4.67-1~deb12u3
RUN echo "security refresh $SECURITY_REFRESH" \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::=--force-confold upgrade \
 && rm -rf /var/lib/apt/lists/* \
 && php_version="$(dpkg-query -W -f='${Version}' php8.2-common)" \
 && if ! dpkg --compare-versions "$php_version" ge "$PHP_FLOOR"; then \
      echo "php8.2-common $php_version is older than $PHP_FLOOR" >&2; exit 1; fi \
 && apache_version="$(dpkg-query -W -f='${Version}' apache2)" \
 && if ! dpkg --compare-versions "$apache_version" ge "$APACHE_FLOOR"; then \
      echo "apache2 $apache_version is older than $APACHE_FLOOR" >&2; exit 1; fi
COPY --from=bin /usnm-boinc /usr/local/bin/usnm-boinc
# The assessment (#456): script_validator's scripts, and the #435 report's scoring scripts,
# unchanged, for the assess-collect step.
COPY contrib-compute/images/bridge/usnm_assess_check contrib-compute/images/bridge/usnm_assess_compare \
     contrib-compute/images/bridge/usnm_gold_check contrib-compute/images/bridge/usnm_surya_check \
     contrib-compute/images/bridge/usnm_surya_compare \
     contrib-compute/images/bridge/usnm_quality_check contrib-compute/images/bridge/usnm_quality_compare \
     contrib-compute/images/bridge/usnm_qwen_check contrib-compute/images/bridge/usnm_qwen_compare \
     contrib-compute/images/bridge/usnm_qwen_train_check \
     contrib-compute/images/bridge/usnm_ndlocr_check contrib-compute/images/bridge/usnm_ndlocr_compare \
     /usr/local/lib/usnm-boinc/
COPY ocr/boinc/train/worker.py ocr/boinc/train/campaign.py ocr/boinc/train/check.py \
     /usr/local/lib/usnm-boinc/train/
COPY ocr/boinc/usnm_ndlocr_in ocr/boinc/usnm_ndlocr_out /usr/local/lib/usnm-boinc/
# OCR bundles (#1059): several usnm_ocr pages in one workunit; submit-remote installs these.
COPY ocr/boinc/usnm_ocr_bundle_in ocr/boinc/usnm_ocr_bundle_out /usr/local/lib/usnm-boinc/
COPY ocr/boinc/usnm_qwen_train_in ocr/boinc/usnm_qwen_train_out /usr/local/lib/usnm-boinc/
COPY ocr/boinc/usnm_iris_in ocr/boinc/usnm_iris_out ocr/boinc/usnm_iris_bundle_in ocr/boinc/usnm_iris_bundle_out contrib-compute/images/bridge/usnm_iris_check /usr/local/lib/usnm-boinc/
COPY ocr/boinc/iris/contract.py ocr/boinc/iris/bundle.py scripts/boinc/iris-campaign.py scripts/boinc/iris-bundle-campaign.py scripts/boinc/iris-check.py /usr/local/lib/usnm-boinc/iris/
RUN mv /usr/local/lib/usnm-boinc/iris/iris-check.py /usr/local/lib/usnm-boinc/iris/check.py \
 && chmod 0755 /usr/local/lib/usnm-boinc/usnm_iris_check
RUN chmod 0755 /usr/local/lib/usnm-boinc/usnm_qwen_train_check
COPY docs/reports/2026-10-jp2-vs-jpeg-ocr/score.py docs/reports/2026-10-jp2-vs-jpeg-ocr/aggregate.py \
     /usr/local/lib/usnm-boinc/assess/
# The gold-bundle step (docs/boinc/gold-check.md#build-the-gold-bundle): gold.py with Pillow and bsdtar
# (BLN600's zip is AES encrypted), usnm-ocr-survey, and the committed lock it must reproduce.
# Pillow is the CI's version (ci.yml), from its manylinux wheel, checked by sha256: the crops
# are JPEG re-encodes, so the tar's bytes depend on it.
ARG PILLOW_URL=https://files.pythonhosted.org/packages/f2/2f/d7675ecae6c43e9f12aa8d58b6012683b20b6edfbdac7abcb4e6af7a3784/pillow-11.3.0-cp311-cp311-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl
ARG PILLOW_SHA256=106064daa23a745510dabce1d84f29137a37224831d88eb4ce94bb187b1d7e5f
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends libarchive-tools \
 && rm -rf /var/lib/apt/lists/* \
 && curl -fsSL -o /tmp/pillow.whl "$PILLOW_URL" \
 && echo "$PILLOW_SHA256  /tmp/pillow.whl" | sha256sum -c - \
 && python3 -m zipfile -e /tmp/pillow.whl /usr/local/lib/usnm-boinc/gold/py \
 && rm /tmp/pillow.whl
ENV PYTHONPATH=/usr/local/lib/usnm-boinc/gold/py
COPY --from=bin /usnm-ocr-survey /usr/local/bin/usnm-ocr-survey
# gold.py and the modules it imports, in the repository's layout: locfetch.py finds jaocr.py
# and alto.py at ../../ja-ocr (their Azure imports are lazy and unused here).
COPY scripts/ocr-survey/gold.py scripts/ocr-survey/locfetch.py scripts/ocr-survey/crops.py \
     scripts/ocr-survey/altotext.py scripts/ocr-survey/transcription.py /usr/local/lib/usnm-boinc/gold/scripts/ocr-survey/
COPY ja-ocr/jaocr.py ja-ocr/alto.py /usr/local/lib/usnm-boinc/gold/ja-ocr/
COPY fixtures/ocr-gold/bundle-v1.lock.json /usr/local/lib/usnm-boinc/gold/bundle-v1.lock.json
COPY fixtures/ocr-gold/selections/ /usr/local/lib/usnm-boinc/gold/selections/
COPY contrib-compute/images/bridge/gold-bundle.sh /usr/local/lib/usnm-boinc/gold-bundle.sh
# The hand-off job (#469): the same image, run in the main environment with this command.
COPY contrib-compute/images/bridge/handoff-job.sh /usr/local/lib/usnm-boinc/handoff-job.sh
ENTRYPOINT ["/usr/local/bin/bridge-job"]
