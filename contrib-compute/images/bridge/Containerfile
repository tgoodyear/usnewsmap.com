# The bridge job image: the server image (the stock project tools, create_work, config rendering
# and /usr/local/bin/bridge-job) plus the usnm-boinc binary from the bridge-bin image. Both come
# in by reference, so this build only copies one file.
#
#   docker build -f contrib-compute/images/bridge/Containerfile \
#     --build-arg SERVER_IMAGE=REGISTRY/usnm-boinc-server@sha256:... \
#     --build-arg BIN_IMAGE=REGISTRY/usnm-boinc-bridge-bin:<tag> contrib-compute/images/bridge
ARG SERVER_IMAGE
ARG BIN_IMAGE
FROM ${BIN_IMAGE} AS bin

FROM ${SERVER_IMAGE}
COPY --from=bin /usnm-boinc /usr/local/bin/usnm-boinc
ENTRYPOINT ["/usr/local/bin/bridge-job"]
