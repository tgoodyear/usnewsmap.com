#!/bin/sh
# script_validator's init script for usnm_quality (#522), called as `usnm_quality_check files`:
# script_validator passes one result's three files (result.json, confusions.json, diag.txt), in
# output template order. Exit 0 when the result is well formed. Every result it sees is copied to
# <project>/quality/seen/<result>/, so each host's diagnostics and timings are kept, not only the
# canonical result's. BOINC's start runs daemons in <project>/tmp_<host>, so ../quality is the
# project's quality/. Linked into bin/.
[ "$#" -eq 3 ] || { echo "usnm_quality_check: expected 3 files, got $#" >&2; exit 2; }
exec /usr/local/bin/usnm-boinc quality check --files "$1" "$2" "$3" \
  --keep "${USNM_QUALITY_DIR:-$(cd .. && pwd)/quality}/seen"
