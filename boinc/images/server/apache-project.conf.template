# Rendered by entrypoint.sh. The master URL is the site root, so the project's user pages are
# the document root; the CGIs and the download directory sit under <project>_cgi and
# <project>_download, as config.xml says.
ServerName @MASTER_HOST@
ServerTokens Prod
# Port 80 comes from Debian's ports.conf; a second Listen here stops Apache starting.
DocumentRoot "@PROJ@/html/user"
Alias /@PROJECT@_download "@PROJ@/download"
Alias /@PROJECT@_ops "@PROJ@/html/ops"
Alias /@PROJECT@ "@PROJ@/html/user"
ScriptAlias /@PROJECT@_cgi "@PROJ@/cgi-bin"
DirectoryIndex index.php index.html

<Directory "@PROJ@/html/user">
    Options Indexes FollowSymLinks
    AllowOverride All
    Require all granted
</Directory>
<Directory "@PROJ@/html/ops">
    Options Indexes FollowSymLinks
    AllowOverride All
    Require all denied
</Directory>
<Directory "@PROJ@/cgi-bin">
    Options ExecCGI
    Require all granted
</Directory>
<Directory "@PROJ@/download">
    Options None
    AllowOverride None
    Require all granted
    <FilesMatch ".*">
        SetHandler none
    </FilesMatch>
</Directory>
<Directory "@PROJ@/keys">
    Require all denied
</Directory>
<Directory "@PROJ@/upload">
    Require all denied
</Directory>
