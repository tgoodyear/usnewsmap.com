#!/bin/sh
# script_validator's compare script for usnm_assess (#456), called as
# `usnm_assess_compare files files2`: script_validator passes two results' files, three each,
# in output template order. Exit 0 when the two agree on outcomes and text. Linked into bin/.
compare() {
  [ "$#" -eq 6 ] || { echo "usnm_assess_compare: expected 6 files, got $#" >&2; exit 2; }
  exec /usr/local/bin/usnm-boinc assess compare --files "$1" "$2" "$3" --files2 "$4" "$5" "$6"
}
compare "$@"
