    <app>
        <name>usnm_iris</name>
        <user_friendly_name>usnewsmap experimental Iris Xe Qwen3-VL-4B OCR pilot</user_friendly_name>
        <min_version>0</min_version><deprecated>1</deprecated>
        <homogeneous_redundancy>0</homogeneous_redundancy>
        <weight>1</weight><beta>0</beta><target_nresults>1</target_nresults>
    </app>
    <platform>
