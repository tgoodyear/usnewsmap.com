<?xml version="1.0"?>
<!-- Input for BOINC's xadd: the science apps and Linux/Mac/Windows platforms.
     A platform registration alone supplies no app version: publish a signed app or wrapper first. -->
<boinc>
    <app>
        <name>usnm_ocr</name>
        <user_friendly_name>usnewsmap OCR (Tesseract, one page per task)</user_friendly_name>
        <min_version>0</min_version>
        <deprecated>0</deprecated>
        <homogeneous_redundancy>0</homogeneous_redundancy>
        <weight>1</weight>
        <beta>0</beta>
        <target_nresults>1</target_nresults>
    </app>
    <app>
        <name>usnm_assess</name>
        <user_friendly_name>usnewsmap JP2 against IIIF JPEG OCR check (one page per task)</user_friendly_name>
        <min_version>0</min_version>
        <deprecated>1</deprecated>
        <homogeneous_redundancy>0</homogeneous_redundancy>
        <weight>1</weight>
        <beta>0</beta>
        <target_nresults>2</target_nresults>
    </app>
    <app>
        <name>usnm_gold</name>
        <user_friendly_name>usnewsmap OCR gold check (scores the host engine on public ground truth)</user_friendly_name>
        <min_version>0</min_version>
        <deprecated>0</deprecated>
        <homogeneous_redundancy>0</homogeneous_redundancy>
        <weight>1</weight>
        <beta>0</beta>
        <target_nresults>1</target_nresults>
    </app>
    <app>
        <name>usnm_ocr_native</name>
        <user_friendly_name>usnewsmap OCR, native Linux build (Tesseract with no container runtime, one page per task)</user_friendly_name>
        <min_version>0</min_version>
        <deprecated>0</deprecated>
        <homogeneous_redundancy>0</homogeneous_redundancy>
        <!-- Weight 0, as usnm_gold_native: every unit is created with target_host for one host
             trust admits (#1780), and the scheduler sends assigned work from the database, not
             the feeder's cache (docs/boinc/apps/native-ocr.md, Rollout step 5). -->
        <weight>0</weight>
        <beta>0</beta>
        <target_nresults>1</target_nresults>
    </app>
    <app>
        <name>usnm_gold_native</name>
        <user_friendly_name>usnewsmap OCR gold check, native Linux build (no container runtime)</user_friendly_name>
        <min_version>0</min_version>
        <deprecated>0</deprecated>
        <homogeneous_redundancy>0</homogeneous_redundancy>
        <!-- Weight 0: its units are only ever assigned to one host (gold-onboard), and the
             scheduler sends assigned work from the database, not the feeder's cache. A zero
             weight takes one cache slot and leaves the other apps' query budgets as they were
             (docs/boinc/apps/native-ocr.md, Rollout). -->
        <weight>0</weight>
        <beta>0</beta>
        <target_nresults>1</target_nresults>
    </app>
    <app>
        <name>usnm_surya</name>
        <user_friendly_name>usnewsmap Surya 2 OCR test (CPU and NVIDIA GPU, one page per task)</user_friendly_name>
        <min_version>0</min_version>
        <deprecated>0</deprecated>
        <homogeneous_redundancy>0</homogeneous_redundancy>
        <weight>1</weight>
        <beta>0</beta>
        <target_nresults>2</target_nresults>
    </app>
    <app>
        <name>usnm_quality</name>
        <user_friendly_name>usnewsmap OCR quality estimate (measures scans and texts, about 200 pages per task)</user_friendly_name>
        <min_version>0</min_version>
        <deprecated>0</deprecated>
        <homogeneous_redundancy>0</homogeneous_redundancy>
        <weight>1</weight>
        <beta>0</beta>
        <target_nresults>2</target_nresults>
    </app>
    <app>
        <name>usnm_qwen</name>
        <user_friendly_name>usnewsmap Qwen3-VL OCR readings (NVIDIA, AMD, Intel or Apple GPU, one page per task)</user_friendly_name>
        <min_version>0</min_version>
        <deprecated>0</deprecated>
        <homogeneous_redundancy>0</homogeneous_redundancy>
        <!-- Weight 16 of 24 across all declarations, including retired apps; live shares use
             only active DB rows and the feeder's startup allocation (see app-release.md). -->
        <weight>16</weight>
        <beta>0</beta>
        <target_nresults>2</target_nresults>
    </app>
    <app>
        <name>usnm_qwen_train</name>
        <user_friendly_name>usnewsmap experimental transcription LoRA training (NVIDIA GPU)</user_friendly_name>
        <min_version>0</min_version>
        <deprecated>1</deprecated>
        <homogeneous_redundancy>0</homogeneous_redundancy>
        <weight>1</weight>
        <beta>0</beta>
        <target_nresults>1</target_nresults>
    </app>
    <app>
        <name>usnm_ndlocr</name>
        <user_friendly_name>usnewsmap Japanese OCR (NDLOCR-Lite, one page per task)</user_friendly_name>
        <min_version>0</min_version><deprecated>0</deprecated>
        <homogeneous_redundancy>0</homogeneous_redundancy>
        <weight>1</weight><beta>0</beta><target_nresults>2</target_nresults>
