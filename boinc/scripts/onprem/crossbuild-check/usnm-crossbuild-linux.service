# Same-build replication check of Linux native (plan native-feed-4, build 4d6e2a3b): re-reads 10 Linux pages
# with the identical Linux build under tight limits. The second instance of usnm-crossbuild-check, with its
# own env file, state directory and syslog tag. See README.md. Exit status 3 means a page was flagged; the
# unit then shows as failed and its journal line says which.
[Unit]
Description=usnewsmap native OCR replication check: Linux native pages re-read with the identical Linux build
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/usnm-crossbuild-linux.env
ExecStart=/usr/bin/python3 /opt/usnm-crossbuild/native_crossbuild_check.py \
    --handoff ${HANDOFF_DIR} --scans ${SCANS_DIR} \
    --tesseract /opt/usnm-crossbuild/linux-build/usnm_tesseract \
    --tessdata /opt/usnm-crossbuild/linux-build/tessdata \
    --trust-file /opt/usnm-crossbuild/native-build-trust.json \
    --models-lock /opt/usnm-crossbuild/models.lock \
    --out-dir /var/lib/usnm-crossbuild-linux --issue ${TRACKING_ISSUE} --threads 2 \
    --cer-limit ${CER_LIMIT} --f1-limit ${F1_LIMIT} --ratio-min ${RATIO_MIN} --ratio-max ${RATIO_MAX} \
    --image ${IMAGE_PREFIX} --host ${HOST_ID} --plan ${PLAN} --label linux
SuccessExitStatus=3
SyslogIdentifier=usnm-crossbuild-linux
StateDirectory=usnm-crossbuild-linux
User=usnm-crossbuild
Nice=19
IOSchedulingClass=idle
CPUQuota=200%
TasksMax=16
MemoryMax=4G
TimeoutStartSec=2h
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/
ReadWritePaths=/var/lib/usnm-crossbuild-linux
