[Unit]
Description=Tesseract worst-first English re-read: one step (tess_worstfirst.py run)
# Runs as root on usnm-batch (CT 215 on pve-laptop): it needs /etc/usnm/quality-reader/dsn (root only)
# and usnm-ingest-run. Install: copy tess_worstfirst.py to /usr/local/lib/usnm-tess-worstfirst/,
# the config to /etc/usnm/tess-worstfirst.json (edit "cut" there), then enable the timer.
[Service]
Type=oneshot
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StateDirectory=usnm-tess-worstfirst
ExecStart=/usr/bin/python3 -I /usr/local/lib/usnm-tess-worstfirst/tess_worstfirst.py run --config /etc/usnm/tess-worstfirst.json --state-dir /var/lib/usnm-tess-worstfirst
