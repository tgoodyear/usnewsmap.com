# On pve-laptop: upsert one verified partial scope under CT230's bridge lock.
# Complete campaign outputs are not replaced. Never runs on pve-big.
[Unit]
Description=usnewsmap bounded partial canonical quality results into usnm_quality
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/usnm/quality-ship.env

[Service]
Type=oneshot
SuccessExitStatus=75
EnvironmentFile=/etc/usnm/quality-ship.env
Environment=CTID=215
Environment=QUALITY_COLLECTOR=/project/ops/quality-results/usnm-boinc
# Seconds for the full scheduling inventory outside the step lock; override in quality-results.env.
Environment=INVENTORY_BUDGET_SECS=3600
# Once the collector above knows --digest-cache: PARTIAL_WARM_ARGS="--warm-without-lock" in
# quality-results.env, so each pass collects its unit first without the step lock and the locked
# pass only re-checks the inputs' identities. Set it for usnm-quality-inventory.service too, so the
# inventory shares the campaign's input digests. Older collectors reject --digest-cache.
Environment=PARTIAL_WARM_ARGS=
EnvironmentFile=-/etc/usnm/quality-results.env
ExecStart=/usr/bin/python3 /opt/usnm-quality-feed/quality_results_partial.py --campaign ${CAMPAIGN} --engine-image ${ENGINE_IMAGE} --ctid ${CTID} --collector ${QUALITY_COLLECTOR} --completion-frontier --no-inline-inventory --inventory-budget-secs ${INVENTORY_BUDGET_SECS} $PARTIAL_WARM_ARGS
# The hourly inventory refresh can use its whole budget (at most 2 hours) before the pass itself.
TimeoutStartSec=2h15min
Nice=10
