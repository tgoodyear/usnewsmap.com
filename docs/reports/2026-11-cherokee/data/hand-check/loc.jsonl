{"crop": "sn83020866_1828-03-06_ed-1_seq-4_P4_TL00082.png", "text": "ᏬᏭᎶᏒᏁᎢ; ᎾᏉ ᎤᏂᎩᏎᎢ, ᎢᏅ ᎤᏪᏅᏎᎢ,, ᎾᎿᏃ"}
{"crop": "sn83020866_1828-03-06_ed-1_seq-4_P4_TL00088.png", "text": "ᎧᏢᏎᏥᏃ ᎤᏮᏓᏛᏅ ᏏᏆ ᎤᎾᏢᏍᏖᏢᏗ"}
{"crop": "sn83020866_1828-03-06_ed-1_seq-4_P4_TL00105.png", "text": "ᏍᏗ; ᎣᏍᏛ ᎠᏄᏬ ᏫᏥᎾᎩ, ᎢᏥᏄᏬᏣ, ᎠᎴ"}
{"crop": "sn83020866_1828-03-06_ed-1_seq-4_P4_TL00107.png", "text": "ᎦᎵᏦᏓᏅᏃ ᏩᎦ ᎠᎩᎾ ᏫᏥᏯᏅᎥ ᎢᏥᎷᎦ,"}
{"crop": "sn83020866_1828-03-06_ed-1_seq-4_P4_TL00121.png", "text": "ᏄᏉ Ꮘ-ᏎᎢ; ᎾᏍᎩᏃ ᎢᏳᏍᏗ ᎤᎪᏓ ᏧᏄᎪᏤᎢ Ꭴ”"}
{"crop": "sn83020866_1828-04-03_ed-1_seq-4_P4_TL00552.png", "text": "ᏨᎯ ᎤᏪᏥ ᎭᏢᏑᏅ ᏳᎳᏯᏊ ᎤᏓᏢᏛ ᎤᏅᏅᎯ,"}
{"crop": "sn83020866_1828-04-03_ed-1_seq-4_P4_TL00576.png", "text": "ᎶᏂᎯᏃ ᏥᏫᏗᎨᎦᏘᏅᏍᏔᏁ ᏩᎯᏳ’ ᏅᏛᏍᏘ ᏂᎦᏚ"}
{"crop": "sn83020866_1828-04-03_ed-1_seq-4_P4_TL00579.png", "text": "ᏂᎦᏚ ᏄᎾᏓᏁᎶᎮᏎᎢ."}
{"crop": "sn83020866_1828-04-03_ed-1_seq-4_P4_TL00581.png", "text": "Ꮫ,-ᏩᏍᎩᏃ (Ꮲ ᎦᎶᏁᎴ” ᎤᏥ ᎤᏂᏁᏤ ᏧᎾᏨᏍᏗ”"}
{"crop": "sn83020866_1828-04-03_ed-1_seq-4_P4_TL00584.png", "text": "ᏩᏍᎩᏃ ᏦᏩᏕ”ᏧᏮᏨᏍᏗ ᎤᏖᏅᏘᏳ” ᎨᏎᎢ"}
{"crop": "sn83020866_1828-04-03_ed-1_seq-4_P4_TL00599.png", "text": "ᏓᎦᏮᏄᎪᏫᏏᏃ ᎠᏧᏣ, ᏣᏍᎩᏃ ᎯᎠ ᎢᎹᏄᎡᏢ ᎠᏃᏎ”"}
{"crop": "sn83020866_1828-04-03_ed-1_seq-4_P4_TL00600.png", "text": "ᎮᏍᏘ, ᏣᏍᎩ ᎠᏁᏢᏔᏅᎯ ᎯᎠ ᏄᏍᏘ ᎦᏛᎦ, ᎤᏁ”"}
{"crop": "sn83020866_1828-04-03_ed-1_seq-4_P4_TL00601.png", "text": "ᎳᏅᎯ ᎢᎨᎳᏗᎪᎭ."}
{"crop": "sn83020866_1828-04-10_ed-1_seq-4_P4_TL00088.png", "text": "ᏄᎯᏳ ᏤᎮ ᎡᎶᏛ ᎤᎬᏫᏳᎯ, ᎬᏂᏨᏳᏉ ᎤᏂᎷᏤ. Ꮵ”"}
{"crop": "sn83020866_1828-04-10_ed-1_seq-4_P4_TL00097.png", "text": "ᏅᎡ ᎠᏥᎸ ᏗᏁᎶᎯ, ᎠᎴ ᏴᏫ ᏗᏃᏪᎳᏁᎯ, ᏩᏍᎩ"}
{"crop": "sn83020866_1828-04-10_ed-1_seq-4_P4_TL00101.png", "text": "6,Ꭶ ᎠᎴ ᏂᎯ ᎦᏚᏱ ᏧᏘᏱ ᎨᏒᎢ; ᏝᏍᎩᏂ ᏣᏍᏘ”"}
{"crop": "sn83020866_1828-04-10_ed-1_seq-4_P4_TL00138.png", "text": "ᎿᏉᏃ ᎡᎶᏛ ᎤᎪᎴᎰᎨᏒ ᎬᏩᏢᏓᏍᏔᏅᏉ"}
{"crop": "sn83020866_1828-04-10_ed-1_seq-4_P4_TL00147.png", "text": "ᏠᎯᎲᎢ, ᎠᎴ ᎤᏣᏗ ᏓᏂᏴᎬᎢ; ᎴᏥᏢ, ᏓᏍᎪᏂᎲ"}
{"crop": "sn83020866_1828-04-10_ed-1_seq-4_P4_TL00153.png", "text": "ᎯᎠ ᏄᏪᏎᎴᎢ, ᏔᎴᎲᎦ, ᎠᎴ ᎭᏘᏄᎦ-Ꭰ”"}
{"crop": "sn83020866_1828-04-10_ed-1_seq-4_P4_TL00155.png", "text": "ᎢᏒ ᎠᏲᏢ ᎬᏅᎢ ᏧᏂᏲᎲᎩ."}
{"crop": "sn83020866_1828-04-10_ed-1_seq-4_P4_TL00164.png", "text": "ᎡᎯ ᎠᎪᏎᎮᏍᏘ, ᏧᎾᏛᏁᎢ."}
{"crop": "sn83020866_1828-04-24_ed-1_seq-4_P4_TL00105.png", "text": "ᎠᏍᎩᎾ ᎤᎪᏢᏰᏗᏱ ᎤᏰᎸᏎᎢ."}
{"crop": "sn83020866_1828-04-24_ed-1_seq-4_P4_TL00110.png", "text": "ᎤᎾᎪᏢᏗᏱ ᎯᏁᎩ; ᎤᏛᏁᎢ,..."}
{"crop": "sn83020866_1828-04-24_ed-1_seq-4_P4_TL00114.png", "text": "ᎿᏆᎴ ᎠᏍᎩᎾ ᏭᏘᏅᏍᏔᏁ ᎦᎸᏉᏗᏘᏳ” Ꮧ"}
{"crop": "sn83020866_1828-04-24_ed-1_seq-4_P4_TL00551.png", "text": "ᎮᏍᏗ ᏱᎨᏩ ᏣᏁᎳᏅᎯ; ᎠᎴ ᏣᏍᎩᏉ ᎤᏩᏒᎯᏳ’"}
{"crop": "sn83020866_1828-04-24_ed-1_seq-4_P4_TL00552.png", "text": "ᏕᎯᏯᏁᎶᏕᏍᏗ,"}
{"crop": "sn83020866_1828-04-24_ed-1_seq-4_P4_TL00560.png", "text": "1Ꮞ. ᏭᎧᎪᎯᏳᏗᏱ ᎠᏰᎸᏒᎡ ᎠᎪᎴᎰᏍᎩ ᏧᏁᏤᎢ;"}
{"crop": "sn83020866_1828-04-24_ed-1_seq-4_P4_TL00576.png", "text": "ᏍᏗᎦᏯᎷᎥᏍᎩ ᏅᏓᏍᏛᏴᏁᏢᎵ."}
{"crop": "sn83020866_1828-04-24_ed-1_seq-4_P4_TL00579.png", "text": "Ꭿ910. ᏩᏳᎿᏃ ᏫᏬᏪᏅᎥ ᎠᏂᏔᏢ ᏄᏮᏓᎴ ᏘᎾᏓᏅ"}
{"crop": "sn83020866_1828-05-28_ed-1_seq-2_P2_TL00536.png", "text": "ᏞᏍᏗ ᏣᏓᎸᎩ; ᎩᎶᏃ ᎢᎠᏓᎸ ᎬᏩᏢᏰᎢᏢᏕᏗ ᎨᏎ--"}
{"crop": "sn83020866_1828-05-28_ed-1_seq-3_P3_TL00008.png", "text": "ᏍᏚᏗᏱᏃ ᏰᏭᏣᏍᎦᏚᎲᎦ."}
{"crop": "sn83020866_1828-05-28_ed-1_seq-3_P3_TL00013.png", "text": "ᎮᎦ. ᎠᏎᏃ ᎠᏴ ᎯᎠ ᏂᏨᏪᏎᎭ, ᎩᎶ ᎠᎨᏴ Ꮣ"}
{"crop": "sn83020866_1828-05-28_ed-1_seq-3_P3_TL00018.png", "text": "ᏧᏢᏍᏖᏁᏗ ᏌᏉᏉ ᏣᏢᎬᎭᎸᏛ ᏱᏣᏲᏆᏎᎭ, ᎥᏝᏃ"}
{"crop": "sn83020866_1828-05-28_ed-1_seq-3_P3_TL00022.png", "text": "ᏁᏘ ᏌᏉᏉ ᏣᎵᎬᎭᏅᏛ ᏱᏣᏲᎱᏎᎭ, ᎥᏝᏃᏬᏃ"}
{"crop": "sn83020866_1828-05-28_ed-1_seq-3_P3_TL00030.png", "text": "ᏔᎵᏁ ᎢᏣᏛᎦᏅ ᎯᎠ ᏥᏂᎨᏥᏪᏎᎴ ᎡᏗ"}
{"crop": "sn83020866_1828-05-28_ed-1_seq-3_P3_TL00061.png", "text": "Ꭵ ᎾᏢᏍᏓᏁᏗᏱ ᎢᏣᏓᎪᏢᏍᏗᏍᎨᏍᏗ ᎦᏱᎪᎩ ᎨᏥᏃ"}
{"crop": "sn83020866_1828-05-28_ed-1_seq-3_P3_TL00065.png", "text": "ᏫᏎ ᎤᏂᏲᎢ ᎠᎴ ᎠᏃᏍᏛ, ᎠᎴ ᏓᎦᏃᏓᏁᎭ ᎤᎾᏓ"}
{"crop": "sn83020866_1828-05-28_ed-1_seq-3_P3_TL00070.png", "text": "ᏎᎢ. ᎢᏅ ᎠᎴ ᎢᏣᏓᏅᎶᏉ ᎤᏅᏒ ᏱᏗᏥᏲᏢᎭ,"}
{"crop": "sn83020866_1828-05-28_ed-1_seq-6_P6_TL00117.png", "text": "ᏗᏍᏓᏓᏅᎶ, ᏁᏢᏍᎬᎧᏃ ᎢᎨᏐᎢ ᎤᏃᏍᏛ ᎠᏓ ᏨᏒ"}
{"crop": "sn83020866_1828-05-28_ed-1_seq-6_P6_TL00131.png", "text": "ᏧᏲᎮ. ᎠᏩᏗᏍᎪᎢ, ᎩᎶᏃ ᏫᏥᎬᏂᎨ ᏣᏥᏍᏚᎢᎡᎰᎢ.,"}
{"crop": "sn83020866_1828-05-28_ed-1_seq-6_P6_TL00132.png", "text": "ᎠᎴ ᎦᎪ ᎠᏍᎦᏯ ᎤᏓᏑᏯ ᎯᎠ ᏥᏂᏣᏛᏅ,;"}
{"crop": "sn83020866_1828-05-28_ed-1_seq-6_P6_TL00138.png", "text": "ᎦᎸᎳᏘᏗ ᎡᎯ ᎣᏍᏛ ᏓᏁᎮᏍᏗ ᎬᏩᏔᏲᏎᎯ."}
{"crop": "sn83020866_1828-05-28_ed-1_seq-6_P6_TL00145.png", "text": "1Ꮞ. ᎠᏯᎪᏢᏳᏰᏃ ᎦᎶᎯᏍᏗᏱ ᎠᎴ ᎠᏍᎪᏢᏨ"}
{"crop": "sn83020866_1828-05-28_ed-1_seq-6_P6_TL00148.png", "text": "ᏕᏤᏯᎪᏤᎮᏍᏗ ᎤᎾᏠᎾᏍᏘ ᎠᎾᏁᎴᎰᏍᎩ;"}
{"crop": "sn83020866_1828-05-28_ed-1_seq-6_P6_TL00185.png", "text": "ᏳᏍᎩ ᎧᏁᎬᎢ ᏴᏫ ᎤᏂᏍᏆᏂᎪᏎᎢ ᏓᏕᏲᎲᏍᎬᎢ;,"}
{"crop": "sn83020866_1828-05-28_ed-1_seq-6_P6_TL00187.png", "text": "Ꭲ; ᎥᏝᏃ ᏘᏃᏪᎵᏢᏍᎩᏉ “ᏥᏓᎾᏕᏲᎲᏍᎪ ᎢᏳᏨᏍᏗ"}
{"crop": "sn83020866_1828-06-11_ed-1_seq-4_P4_TL00090.png", "text": "ᎠᎧᏔ ᎠᏰᎸᎢ ᎢᎦ ᎦᏗᏍᏗᏍᎩ, ᎢᏳᏍᎩ"}
{"crop": "sn83020866_1828-06-11_ed-1_seq-4_P4_TL00093.png", "text": "ᎢᏳᏨᏍᎩᏂ ᎯᎧᎪᏢ ᎤᏐᏅᎢᏉ ᎢᎨᏎᏍᏘ;"}
{"crop": "sn83020866_1828-06-11_ed-1_seq-4_P4_TL00115.png", "text": "ᏂᏄᎸᏫᏍᏓᏁᎰᎢ Ꮭ ᎠᎴ ᏯᏂᏍᎪᎰᎢ."}
{"crop": "sn83020866_1828-06-11_ed-1_seq-4_P4_TL00116.png", "text": "ᎠᏎᏃ ᎯᎠ ᏂᏨᏪᏎᎭ; ᏐᎢᎹᏅ ᏣᏍᏉ"}
{"crop": "sn83020866_1828-06-11_ed-1_seq-4_P4_TL00119.png", "text": "ᎢᏳᏰᏃ ᎤᏁᎳᏅᎯ ᏣᏍᎩ ᏱᏂᎬᏁᎭ Ᏹ’"}
{"crop": "sn83020866_1828-06-11_ed-1_seq-4_P4_TL00124.png", "text": "ᏱᏂᏥᏪᏍᎨᏍᏘ;, ᎦᎪ ᏖᏂᏥᎩ; ᎠᎴ ᎦᎪ ᏓᏂᏣᏗ"}
{"crop": "sn83020866_1828-06-11_ed-1_seq-4_P4_TL00125.png", "text": "ᏔᎯ, ᎠᎴ ᎦᎪ ᏖᏓᏲᏣᏄᏬᎢ;"}
{"crop": "sn83020866_1828-06-11_ed-1_seq-4_P4_TL00134.png", "text": "Ꭵ ᏍᏔᏂ- ᏭᏢᏉ ᏰᏃ ᎤᏂᎢ ᎢᎦ ᎤᏪᎲᎢ:"}
{"crop": "sn83020866_1828-06-25_ed-1_seq-4_P4_TL00049.png", "text": "Ꭱ ᎠᎴ ᎬᏂᏅᏉ ᎠᏓᏰᏍᎩ ᎤᏢᎩ ᎤᎷᏤ ᎤᏓ"}
{"crop": "sn83020866_1828-06-25_ed-1_seq-4_P4_TL00051.png", "text": "ᏣᏓᏅᏕᎲ ᏰᏢᏉ ᏱᏍᎩᏅᎦᎸ."}
{"crop": "sn83020866_1828-06-25_ed-1_seq-4_P4_TL00056.png", "text": "ᏁᏢ, ᎮᏫᏍᎩᏂ, ᏫᏣᎪᏩᏛ ᎠᏥᏂᎸ ᎨᎶᎯ; ᎠᎴ ᎠᏢ"}
{"crop": "sn83020866_1828-06-25_ed-1_seq-4_P4_TL00059.png", "text": "5.”ᎿᏉᏃ ᏥᏠ ᎤᎾᏄᎪᏥᎯ ᏥᎬᏆᏂ ᎤᎷᏤᎴ"}
{"crop": "sn83020866_1828-06-25_ed-1_seq-4_P4_TL00060.png", "text": "ᎠᏍᎪᎯᏧᏈ ᏗᏓᏘᏂᎪᎯ, ᎤᏍᏘᏰᏕᎢ.."}
{"crop": "sn83020866_1828-06-25_ed-1_seq-4_P4_TL00061.png", "text": "Ꮾ, ᏱᎠ ᏄᏪᏎᎮᎢ, ᏣᎬᏫᏳᎯ; ᏥᏅᏏᏓᏍᏘ Ꭶ"}
{"crop": "sn83020866_1828-06-25_ed-1_seq-4_P4_TL00068.png", "text": "ᏅᏏᏖᏍᏗᏃ ᏓᏨᏘᏩᏏ. Ꮅ ᏌᏁ"}
{"crop": "sn83020866_1828-07-02_ed-1_seq-4_P4_TL00206.png", "text": "ᏥᏌᏃ ᏚᎪᎲ ᎤᏂᏣᏘ ᏴᏫ ᎬᏩᏜᏫᏍᏘᏍᎬ"}
{"crop": "sn83020866_1828-07-02_ed-1_seq-4_P4_TL00224.png", "text": "ᎯᎠᏃ ᏂᏚᏪᏎᎴᎢ; ᏕᎪᏃ ᎢᏥᏍᎦᎢᎭ, Ꮒ"}
{"crop": "sn83020866_1828-07-02_ed-1_seq-4_P4_TL00230.png", "text": "ᏕᎷᏨᏃ ᎣᎪᏂᏘᏢ ᎦᎩᏏᏂ ᎤᏮᏤᎵᎪᎯ,"}
{"crop": "sn83020866_1828-07-02_ed-1_seq-4_P4_TL00234.png", "text": "ᎠᎴ ᎬᏂᏳᏉ ᎤᏁᎷᏁᎢ: ᎯᎠ ᏄᏂᏪᏎᎢ:"}
{"crop": "sn83020866_1828-07-02_ed-1_seq-4_P4_TL00238.png", "text": "ᎨᎯᏃ ᎢᎠᏛ- ᏘᏁᎪᎮ ᎤᏂᏣᏗ,. ᎤᎾᏓᏡᎩ"}
{"crop": "sn83020866_1828-07-02_ed-1_seq-4_P4_TL00249.png", "text": "ᏂᎦᏛ ᏚᏂᏃᎮᎴᎢ, ᎠᎴ ᎠᏂᏍᎩᎾ ᎬᏩᏂᏱ ᏄᎾᏢᏍᏔ"}
{"crop": "sn83020866_1828-07-23_ed-1_seq-4_P4_TL00106.png", "text": "Ꭲ. ᏥᏅᎯᏃ ᎤᎶᏅᎥ, ᏚᏬᏐᏤᎢ, ᎤᏩᏒ ᎤᏪᏚᎲ"}
{"crop": "sn83020866_1828-07-23_ed-1_seq-4_P4_TL00110.png", "text": "ᎲᏍᎬ, ᎯᎠ ᏄᏪᏎᎴ ᎤᎸᏓᎸᎥᏍᎩ; ᎠᏊᏥ; ᎤᎦᎵ"}
{"crop": "sn83020866_1828-07-23_ed-1_seq-4_P4_TL00129.png", "text": "ᏍᏓᏩᏚᎦ. ᏚᎴᏅᏃ ᎤᏍᏓᏩᏛᏒᎩ."}
{"crop": "sn83020866_1828-07-23_ed-1_seq-4_P4_TL00149.png", "text": "ᏥᏌᏃ ᎯᎠ ᏂᏚᏪᏎᎸᎩ, ᏥᎪ ᏰᏢ ᏕᎨᎦᏨ"}
{"crop": "sn83020866_1828-07-23_ed-1_seq-4_P4_TL00155.png", "text": "ᏄᏬ, ᎤᏓᏣᎦᎸᏄᎲᏃ ᎤᏳ ᎡᏉᎯᏳ ᏂᎦᏢᏍᏗᏍᎪᎢ."}
{"crop": "sn83020866_1828-07-23_ed-1_seq-4_P4_TL00187.png", "text": "ᏥᏠᏃ ᎯᎠ ᏂᏚᏪᏎᎸᎩ; ᎢᏍᎪᎯᏳᎲᏍᎦᏍᎪ ᏰᏢ"}
{"crop": "sn83020866_1828-07-23_ed-1_seq-4_P4_TL00194.png", "text": "ᎠᏎᏃ ᎤᎾᏖᏣᎥᏒᏉ ᏚᏂᏃᏣᎳᏅᎩ ᎾᎿ ᏂᎬ"}
{"crop": "sn83020866_1828-07-23_ed-1_seq-4_P4_TL00212.png", "text": "ᏠᎨᏏ ᎤᎧᏛᎾᏨᎯ ᎡᏉᎯᏳ’, ᎠᏎᏃ ᎠᏂᎦᏲᏢᏳ” ᏧᏂ"}
{"crop": "sn83020866_1828-08-06_ed-1_seq-4_P4_TL00114.png", "text": "Ꮡ ᎧᏚᏯᏅᎲᏃ ᏔᎳᏚ ᎢᏯᏂᏛ ᎬᏩᏍᏖᏩᏘ"}
{"crop": "sn83020866_1828-08-06_ed-1_seq-4_P4_TL00142.png", "text": "ᎤᏩᏛᏘᏗ ᎨᏐ ᎤᏢᏍᏖᏓᏴᏗ."}
{"crop": "sn83020866_1828-08-06_ed-1_seq-4_P4_TL00173.png", "text": "ᎠᎴ ᎠᏍᏕᏯ ᎪᏖᏨᏲᏏ ᎤᏲᎱᎯᏍᏘᏱ ᏗᏅ"}
{"crop": "sn83020866_1828-08-06_ed-1_seq-4_P4_TL00184.png", "text": "9Ꮞ. ᏗᎦᎶᏆᏍᎩ ᎥᏝ ᏧᏪᏂᏁᏂᎲᏍᎩ ᏳᏖᏢᏁᎯᏂᎢ;,"}
{"crop": "sn83020866_1828-08-06_ed-1_seq-4_P4_TL00200.png", "text": "ᎠᏂᏔᏢᎧᏂ ᏥᏍᏆᏯ ᏌᏉ ᎢᏯᏓᏅᏕᏘ ᏧᎾ"}
{"crop": "sn83020866_1828-08-06_ed-1_seq-4_P4_TL00208.png", "text": "ᎲᎢ, ᏳᏇᏉᏍᎩᏂ ᏳᏍᏯᎩ ᎬᏂᎨᏒ ᏅᏓᏥᏴᏁᏢ Ꭱ"}
{"crop": "sn83020866_1828-08-06_ed-1_seq-4_P4_TL00234.png", "text": "ᏓᏂᎸᎨᏍᏗ; ᎩᎶᏃ ᎠᏴ ᏓᏆᏓᏂᎸᏌᏍᏗ, ᏩᏍᎩ"}
{"crop": "sn83020866_1828-08-06_ed-1_seq-4_P4_TL00240.png", "text": "ᏗᏍᎨᏍᏘ, ᎤᏓᏅᏘ ᎠᏍᎦᏯ ᎠᎦᎫᏴᏓᏁᏗ ᎥᎨᏒ Ꮹ"}
{"crop": "sn83020866_1828-09-03_ed-1_seq-4_P4_TL00158.png", "text": "ᏣᏂᏲᏍᏘᏍᎪ ᎠᏥᎸ ᎠᏁᎶᎯ, ᎠᎴ ᎤᏂᏍᎦᏅᏨ Ꮒ"}
{"crop": "sn83020866_1828-09-03_ed-1_seq-4_P4_TL00161.png", "text": "ᎸᏉᏘᏳ ᎡᏍᎦᏉ ᎤᏛᏅ ᏗᎦᎳᏫᎢᏍᏗᏱ."}
{"crop": "sn83020866_1828-09-03_ed-1_seq-4_P4_TL00167.png", "text": "ᏣᎿᏃ ᎤᏖᏅᏒ, ᏧᏂᎳᏫᎢᏍᏗᏱ ᏚᏴᎸᎩ.’."}
{"crop": "sn83020866_1828-09-03_ed-1_seq-4_P4_TL00175.png", "text": "ᎤᎶᎯᏳ ᏂᎦ ᎤᏢᏍᎨᏛᏯ ᏴᏫ ᎡᏍᎦᏉ"}
{"crop": "sn83020866_1828-09-03_ed-1_seq-4_P4_TL00178.png", "text": "ᎿᏉᏃ ᎯᎠ ᏄᏪᏎᎸ ᎠᏫᏅ; ᎭᎪᏯᏅᎯᏓ;"}
{"crop": "sn83020866_1828-09-03_ed-1_seq-4_P4_TL00183.png", "text": "ᎠᏎᏃ ᏥᏌ ᎤᎪᎴᎨᏒ ᏩᎿ ᎤᏓᏅᏒᎩ; ᎤᏂ"}
{"crop": "sn83020866_1828-09-03_ed-1_seq-4_P4_TL00188.png", "text": "ᎬᏂᏬᏉ ᏥᏅᏏᏓᏍᏗ ᏥᏯᏑᏰᏛ ᏥᎨᏳᎢ"}
{"crop": "sn83020866_1828-09-03_ed-1_seq-4_P4_TL00190.png", "text": "ᏖᏘ; ᎾᏂᎦᏔᏩᎥᎾᏃ ᏚᏳᎪᏛ ᏧᎾᏄᎪᏫᏎᏗ ᎨᏎᏍᏗ."}
{"crop": "sn83020874_1829-03-04_ed-1_seq-3_P3_TL00539.png", "text": "ᎵᏢᏊᏨᏃ ᎠᎴ ᏚᏅᏩᏅ ᏧᏝᏢᎩ."}
{"crop": "sn83020874_1829-03-04_ed-1_seq-3_P3_TL00540.png", "text": "ᎤᏒᏃ ᏄᏢᏍᏔᏅ ᎬᏩᏍᏓᏩᏗᎪ ᏂᏩᎷᎴ"}
{"crop": "sn83020874_1829-03-04_ed-1_seq-3_P3_TL00550.png", "text": "Ꭼ ᏚᏁᏤᎸᏃ ᎤᏂᏣᏘ ᎧᏁᏍᎪᏯ ᎤᎾᏟ--“Ᏹ,"}
{"crop": "sn83020874_1829-03-04_ed-1_seq-3_P3_TL00561.png", "text": "ᏩᏗᎪᎯ ᏥᏳᎯ ᎤᎾᏦᏗᏱ ᎢᎬᏱ ᏂᎦᏂᎭᏱᏍ."}
{"crop": "sn83020874_1829-03-04_ed-1_seq-3_P3_TL00562.png", "text": "ᎠᏏ ᏓᏰᏢᎯᏍᏗᏍᎬ ᎤᏂᏣᏘ,"}
{"crop": "sn83020874_1829-03-04_ed-1_seq-3_P3_TL00566.png", "text": "2Ꮞ. ᏥᏳᏃ ᎿᏉ ᎠᏰᏢᏳ ᎥᏓᏢ ᏩᏂᏂᏒᎩ ᎤᏝ”"}
{"crop": "sn83020874_1829-03-04_ed-1_seq-3_P3_TL00572.png", "text": "Ꭹ, ᎯᎠᏃ ᏄᏂᏪᏒᎩ; ᎯᎠ ᎾᏰᎯ. ᎿᏉᏃ ᎤᏁᎷᏅ"}
{"crop": "sn83020874_1829-03-04_ed-1_seq-3_P3_TL00591.png", "text": "ᎦᏎ, ᏮᎳᏃ ᏚᏂᏐᏒᏊ ᎡᏂᏏᎳᏗ ᎤᏂᏮᏄᏄᏥᎲ"}
{"crop": "sn83020874_1829-03-11_ed-1_seq-3_P3_TL00443.png", "text": "ᎠᏍᎦᏯ, ᏓᏳᏄᎪᏨᎯᏍᎩᏂ ᎠᎰᏢ ᏳᏍᎩ ᎦᏓᎭ Ꮔ"}
{"crop": "sn83020874_1829-03-11_ed-1_seq-3_P3_TL00449.png", "text": "Ꮣ ᎤᏫᏒᎯ ᏂᎨᏒᎾ ᏗᎦᏫᏍᏕᏢᏗ ᎨᏎᏍᏗ."}
{"crop": "sn83020874_1829-03-11_ed-1_seq-3_P3_TL00451.png", "text": "ᎪᎯ; ᎢᏳᏃ ᏗᏂᏫ ᏯᏘᏂ ᏗᏥᎨᏫ” ᎢᏧᎳ ᎠᏓᎴᏒ Ꮷ"}
{"crop": "sn83020874_1829-03-11_ed-1_seq-3_P3_TL00456.png", "text": "Ꭿ ᏂᏦᎬᏣᏛᏮᏉ ᎢᎩ. Ꮅ"}
{"crop": "sn83020874_1829-03-11_ed-1_seq-3_P3_TL00462.png", "text": "ᏗᏭ9. ᎣᏃᎯᏱᏰᏃ ᏗᏓᎴᎲᏍᎪ ᎤᏎᏅ ᎠᏓᏅᏖᏘᎭ"}
{"crop": "sn83020874_1829-03-11_ed-1_seq-3_P3_TL00474.png", "text": "ᏗᎪᎯᏃ ᎬᏩᎷᏤᎸᎩ, ᏮᏩᏔᏲᏎ-Ꭹ, ᎯᎠ ᏄᎥ,Ꮺ”"}
{"crop": "sn83020874_1829-03-11_ed-1_seq-3_P3_TL00496.png", "text": "Ᏸ1. ᏩᏍᎩᏃ ᎢᏑᏍᏗ ᎤᏂᎶᎯ ᎤᏂᏍᏆᎥ ᎪᏒᏎ"}
{"crop": "sn83020874_1829-03-11_ed-1_seq-3_P3_TL00507.png", "text": "Ꮲ ᎪᏓᏂᏥᎩᏏ ᎦᏚ ᎢᏮᎵᎢ ᏳᏍᎩ ᎢᏳᏂᏣᏘ ᏰᎮ Ꮷ"}
{"crop": "sn83020874_1829-03-18_ed-1_seq-3_P3_TL00325.png", "text": "ᎠᎴ ᏑᎾᎴ ᏥᏥᎨᏐ, ᎪᎯ ᎢᎦ ᏥᎩ ᏛᎦᎿᏂ; Ꭶ"}
{"crop": "sn83020874_1829-03-18_ed-1_seq-3_P3_TL00333.png", "text": "ᎬᏩᏍᏓᏩᏗᎪᎯᏃ ᏚᏂᏐᏨ ᎤᏅᏥᏫᏎ ᎤᎾᏕ"}
{"crop": "sn83020874_1829-03-18_ed-1_seq-3_P3_TL00344.png", "text": "ᏔᏗᏳ ᏥᏧᏖᏒᎩ."}
{"crop": "sn83020874_1829-03-18_ed-1_seq-3_P3_TL00372.png", "text": "ᏒᏍᏗ ᎨᏎᏍᎣᏗ ᎦᎸᎳᏗ."}
{"crop": "sn83020874_1829-03-18_ed-1_seq-3_P3_TL00373.png", "text": "ᎿᏉᏃ ᏚᏅᏍᏓᎮᎸ ᎬᏩᏍᏓᏩᏘᎪᎯ Ꭹ:"}
{"crop": "sn83020874_1829-03-18_ed-1_seq-3_P3_TL00388.png", "text": "Ꭿ; ᎢᏳᏃ ᎩᎶ ᎤᏚᏢᏍᎨᏍᏘ ᎠᎩᏍᏓᏩᏛᏍᏗᏱ;"}
{"crop": "sn83020874_1829-03-18_ed-1_seq-3_P3_TL00393.png", "text": "ᏗᎦᏢᏍᎪᏗᏍᎨᏍᏗ ᎤᏩᏛᏗ ᎨᏎᏍᏗ.;"}
{"crop": "sn83020874_1829-03-18_ed-1_seq-3_P3_TL00398.png", "text": "ᏉᏗᏳ ᎨᏒ ᎤᏄᏬᏍᏕᏍᏘ ᎠᎴ ᏗᏂᎧᎧᏩᏗᎪ ᏓᏘ"}
{"crop": "sn83020874_1829-04-01_ed-1_seq-3_P3_TL00230.png", "text": "ᎢᎦᏗ ᎣᏓᎸ. Ꭹ Ᏹ"}
{"crop": "sn83020874_1829-04-01_ed-1_seq-3_P3_TL00237.png", "text": "Ꭸ ᎣᎯ ᎠᏂ ᏥᏕᎪᎭ ᎢᏳᏃ ᎣᏏ. ᎯᏰ-ᎥᏅ ᏦᎢ ᏫᎪ"}
{"crop": "sn83020874_1829-04-01_ed-1_seq-3_P3_TL00248.png", "text": "ᏚᏮᎦᎧᏅᏃ Ꮭ ᎩᎶ ᏳᏂᎪᎮᎢ ᏥᏌ ᎤᏩᏒ."}
{"crop": "sn83020874_1829-04-01_ed-1_seq-3_P3_TL00263.png", "text": "-1Ꮞ, ᎿᏉᏃ ᎤᏂᏣᏘ ᎠᏁᎪᎲ ᎤᏂᎷᏨ; ᏣᎿ Ꭴ"}
{"crop": "sn83020874_1829-04-01_ed-1_seq-3_P3_TL00283.png", "text": "ᎪᎱᏍᏗ ᏱᎬᏥᏄ-ᎪᎲᏍᎦ. Ꭵ"}
{"crop": "sn83020874_1829-04-01_ed-1_seq-3_P3_TL00289.png", "text": "ᏚᏬᏎᎴᎢ. ᎤᏣᏔᏅᎯᏃ ᎤᏲᏂ ᎤᏂᏏᏰᎸᏅᎩ."}
{"crop": "sn83020874_1829-04-01_ed-1_seq-3_P3_TL00291.png", "text": "ᎪᎯ ᎬᏩᎷᏤᎴ ᏈᏓ; ᎯᎠ ᏄᏂᏪᏎᎢ, ᏝᏍᎪ ᎢᏤᏂᎲ"}
{"crop": "sn83020874_1829-04-01_ed-1_seq-3_P3_TL00294.png", "text": "ᏍᎪᏓᏁᎸ ᎯᎠ ᏄᏪᏒᎩ; .ᎦᎪ ᎮᏢᎠ ᏌᏩᏂ; ᎦᎪ Ꭴ"}
{"crop": "sn83020874_1829-04-08_ed-1_seq-3_P3_TL00422.png", "text": "ᏫᏭᎶᏓᎢᏅ ᏂᎬᏠᏍᎬᎾ ᎠᏥᎸᏱ ᏗᎨᏒᎢ.."}
{"crop": "sn83020874_1829-04-08_ed-1_seq-3_P3_TL00425.png", "text": "ᎢᏣᎵᏍᏖᏁᏗ ᏌᏉ ᏱᏊᎠᎾ ᎬᏂᏛ ᏗᎨᏒ ᏫᏱᏣᏴᎸ,"}
{"crop": "sn83020874_1829-04-08_ed-1_seq-3_P3_TL00444.png", "text": "ᏍᏗᏃᎯᏃᏁᎥᏍᏗ ᎤᏡᎦᏅᏨ ᎢᏍᏛᏒ ᏑᏒᎢ;, ᎢᏳᏃ"}
{"crop": "sn83020874_1829-04-08_ed-1_seq-3_P3_TL00463.png", "text": "“ᏫᏱ ᎠᏢ ᏓᏆᏁᎥ ᏥᏅᏗᎦᎵᏍᎪᏗᏍᎪᎢ; ᎾᏳ ᎠᏰᏢ"}
{"crop": "sn83020874_1829-04-08_ed-1_seq-3_P3_TL00465.png", "text": "ᎿᏉᏃ ᏈᏓᏖ ᎤᎷᏤᎸ ᎯᎠ ᏄᏪᏒᎩ); ᏣᎬᏫ"}
{"crop": "sn83020874_1829-04-08_ed-1_seq-3_P3_TL00479.png", "text": "ᎤᏅᏤᎢ’ ᎠᎴ ᎤᏓᏁᎮᏍᏖᏓᏁᎴᎢ; ᎯᎠ ᏄᏪᏎᎢ: ᎠᎩᎮ"}
{"crop": "sn83020874_1829-04-08_ed-1_seq-3_P3_TL00502.png", "text": "ᏓᏍᏕᎲᏍᎩ ᎤᎫᎮᎰᎲᏍᏗᏱ ᏂᎦᏛ ᎠᏥᏃᎬ ᎢᎪᎯᎩᎿᎴ"}
{"crop": "sn83020874_1829-04-08_ed-1_seq-3_P3_TL00505.png", "text": "-1.ᏂᏘᏗᏥᎪᏢᏃᎾ ᎢᎨᏎᏍᏗ ᎦᏳᏢᏅᏢ ᎤᏂᏍᎦᏅᏨᎢ."}
{"crop": "sn83020874_1829-06-17_ed-1_seq-3_P3_TL00235.png", "text": "ᏍᏗ ᎠᏓᏂᏁᎮᏍᏗ."}
{"crop": "sn83020874_1829-06-17_ed-1_seq-3_P3_TL00247.png", "text": "ᏧᏏᏔᏁᏍᏗᏱ ᎠᎴ ᎤᏓᎪᏢᏍᎪᏗᏱ, ᎬᏩᏍᏓᏩᏗ"}
{"crop": "sn83020874_1829-06-17_ed-1_seq-3_P3_TL00269.png", "text": "ᏥᏠᎯᎠ ᏄᏪᏎᎸᎩ; ᎢᏳ ᏣᏍᏆᏘᏍᏗᏱ"}
{"crop": "sn83020874_1829-06-17_ed-1_seq-3_P3_TL00274.png", "text": "Ꮦ ᎢᏳ ᎤᏰᎸᏅᎩ, ᎤᏣᏘᏰᏃ ᎤᏪᎿᎢᏅ ᏥᏒᎩ.."}
{"crop": "sn83020874_1829-06-17_ed-1_seq-3_P3_TL00283.png", "text": ".Ꮬ ᏏᏌᏃ ᏚᎾᎧᎶᏅ ᎯᎠ ᏄᏂᏪᏎᎸᎩ; ᏴᏫ"}
{"crop": "sn83020874_1829-06-17_ed-1_seq-3_P3_TL00307.png", "text": "ᏦᏧᏫᏒ ᎤᏁᏅᏍᏗᏱ ᎦᏚᏁᏤᎴᎢ."}
{"crop": "sn83020874_1829-06-17_ed-1_seq-3_P3_TL00352.png", "text": "Ꮵ ᎪᏓᎨᏥᏲᎯᏎᏢ ᏄᏂᎬᏫᏳᏒ ᎠᏥᎸ-ᎠᏁᎴᎯ ᎠᎴ"}
{"crop": "sn83020874_1829-06-17_ed-1_seq-3_P3_TL00381.png", "text": "ᏍᎨᏍᏗ ᏣᏍᎩ ᎡᏥᎶᏝᎢ ᎨᏎᏍᏗ, Ꭹ"}
{"crop": "sn83020874_1829-06-24_ed-1_seq-3_P3_TL00138.png", "text": "ᏩᏍᎩᏯ ᏫᏄᎾᏛᏁᎸᎩ,"}
{"crop": "sn83020874_1829-06-24_ed-1_seq-3_P3_TL00154.png", "text": "ᏴᏍᎩ ᏚᏂᏍᎩᎸᎢ ᎠᎴ ᎫᎴ-ᏗᏂᏍᎪᏂᎯ ᏗᏂᏮᏕᏚᎩ"}
{"crop": "sn83020874_1829-06-24_ed-1_seq-3_P3_TL00165.png", "text": "ᎭᏛᎩᏍᎪ ᎯᎠ ᏥᎾᏂᏪᎠᎮ ᎬᏬᏎᎸᎩ."}
{"crop": "sn83020874_1829-06-24_ed-1_seq-3_P3_TL00210.png", "text": "ᎠᏂᏍᎦᏯ ᏧᏪᏥ ᎠᏁᎮᎢ; ᎤᎷᏤᎴᏃ ᎤᏓᏂᏢᎨᎢ"}
{"crop": "sn83020874_1829-06-24_ed-1_seq-3_P3_TL00251.png", "text": "ᏎᎸ. ᏂᏌᏃ ᎯᎠ ᏄᏚᏪᏎᎸᎩ;, ᏝᏍᎪ ᎯᎸᎯᏳ”"}
{"crop": "sn83020874_1829-06-24_ed-1_seq-3_P3_TL00281.png", "text": "Ꮾ,. ᎠᏂᏐᏃ ᏥᏚᏂᏂᏴᎮ ᏧᏅᏏᏖᏍᏗ. ᎠᎴ ᏥᏗᎬ"}
{"crop": "sn83020874_1829-06-24_ed-1_seq-3_P3_TL00336.png", "text": "Ꮆ; ᎤᏓᏂᏢᎨᎬᏃ ᎤᏕᏒᏅ ᎤᏂᎱᏒᎩ, ᎾᏁᎲᎧᏃ ᎨᏒ"}
{"crop": "sn83020874_1829-06-24_ed-1_seq-3_P3_TL00358.png", "text": "9Ꮞ,. ᎠᏂᏆᏢᏏᏍᎩᏂ ᎤᎾᏛᎦᏅ ᎡᎳᏪᏱ ᏂᏚᏩ”"}
{"crop": "sn83020874_1829-07-01_ed-1_seq-3_P3_TL00337.png", "text": "ᏌᏉᏰᏃ ᏗᏣᏁᏂᎪᎯ ᎦᏟᎶᏁᏛ-"}
{"crop": "sn83020874_1829-07-01_ed-1_seq-3_P3_TL00367.png", "text": "ᏍᏗ. ᎠᏢᏍᎪᎸᏔᏅᎯ ᏩᎿ ᎠᎲ ᏣᏲᎪ; ᏳᏍᎩ ᎠᏍᏓ"}
{"crop": "sn83020874_1829-07-01_ed-1_seq-3_P3_TL00378.png", "text": "ᎯᎧ. ᎠᎴ ᎩᎶᎥᎢᎧᏁᎢᏍᏗᏍᎨᏍᏗ ᎦᎸᎳᏗ; Ꭶ"}
{"crop": "sn83020874_1829-07-01_ed-1_seq-3_P3_TL00381.png", "text": "ᎢᏥᏆᏔᎵᏢᏏ ᎢᏣᏠᎾᏮᏍᏗ! ᎠᏍᎪᎯᏁᏰᏃ ᎢᏣᎫᏱᏍᎪ"}
{"crop": "sn83020874_1829-07-01_ed-1_seq-3_P3_TL00403.png", "text": "ᏬᏂᎢᏳ ᎢᏣᎵᏍᏓᏁᏗ. ᏗᏦᏪᏢᏍᎩ ᎠᎴ"}
{"crop": "sn83020874_1829-07-01_ed-1_seq-3_P3_TL00414.png", "text": "ᎦᎵᏫᎪᏓ ᏱᏣᏁᏫᏏ ᎠᎩᎨᎥᎢᏍᏗᏱ ᏨᏍᎩᏃᎢ,"}
{"crop": "sn83020874_1829-07-01_ed-1_seq-3_P3_TL00437.png", "text": "ᎬᏩᏍᏓᏩᏘᎪᎯᏃ ᎬᏩᎷᏤᎸ ᎬᏩᏃᏁᎵᎸ ᏂᏚᏍᏛ"}
{"crop": "sn83020874_1829-07-01_ed-1_seq-3_P3_TL00448.png", "text": "ᏍᏘᏗ ᎩᎶᏍᎩᏂ ᎠᏥᎶᏄᎲᎵ;"}
{"crop": "sn83020874_1829-07-22_ed-1_seq-3_P3_TL00147.png", "text": "ᎯᎠᏰᏃ ᎠᏠᏁᏗ ᏳᎾᏗᏅᏎ ᎤᏣᏘ ᏱᏚᎬᏩ"}
{"crop": "sn83020874_1829-07-22_ed-1_seq-3_P3_TL00170.png", "text": "ᎨᏒ, ᎬᏩᏍᏓᏩᏗᎪᎯ ᎬᏩᎷᏤᎸ ᎯᎠ ᏂᎬᏩᏪᏎᏄ"}
{"crop": "sn83020874_1829-07-22_ed-1_seq-3_P3_TL00541.png", "text": "ᎯᎷᎩ. ᎿᏉᏃ ᎤᏂᎷᏨ ᎠᎴ ᏥᏌ ᎬᏩᏂᏴᎲᎩ."}
{"crop": "sn83020874_1829-07-22_ed-1_seq-3_P3_TL00574.png", "text": "ᎠᏂᏃᎮᏍᎩ ᎤᏂᏮᏄᎳᏤᎢ, ᎠᏎᏃ ᎤᎾᏠᏤᏉ. ᎤᏢ"}
{"crop": "sn83020874_1829-07-22_ed-1_seq-3_P3_TL00579.png", "text": "ᎪᏓᏆᏛ ᎬᏆᏁᏍᎬᏗ. Ꮒ"}
{"crop": "sn83020874_1829-07-22_ed-1_seq-3_P3_TL00582.png", "text": "ᏣᏂᏃᎮᎴᎭ ᏥᎨᏣᏡᏘᎭᎮ"}
{"crop": "sn83020874_1829-07-22_ed-1_seq-3_P3_TL00605.png", "text": "ᏪᏎᎢ; ᎥᏝ ᏱᏥᎦᏔᎭ ᏂᏥᏪᎭ: Ꭱ Ꮈ"}
{"crop": "sn83020874_1829-07-22_ed-1_seq-3_P3_TL00612.png", "text": "ᏂᎬᏩᏪᏎᎴ ᏡᏓ; ᎤᎪᎯᏳᎯ ᏩᏍᏉ’ ᏂᎯ ᎢᏤᎲᎩ,"}
{"crop": "sn83020874_1829-08-05_ed-1_seq-3_P3_TL00166.png", "text": "ᎬᏴ; ᏞᏍᏗ ᏂᎯ ᏱᏍᏗᏍᎦᎢᎮᏍᏗ, ᏥᎦᏔᎭᏰᏃ ᏥᏌ"}
{"crop": "sn83020874_1829-08-05_ed-1_seq-3_P3_TL00168.png", "text": "Ꮾ, ᎥᏝ ᎠᏂ ᏱᎦᎾ, ᏚᎴᏅᏰᏃ ᏩᏍᎩᏯ ᏄᏪᏒᎢ;"}
{"crop": "sn83020874_1829-08-05_ed-1_seq-3_P3_TL00175.png", "text": "ᎢᎮ ᎠᎴ ᎤᏣᏘ ᎠᏮᏢᎮᏢᎨᎢ; ᎠᎴ ᏚᏂᏍᏆᎸᏔᏁ Ꭼ-Ꭾ"}
{"crop": "sn83020874_1829-08-05_ed-1_seq-3_P3_TL00181.png", "text": "ᎿᎹᏃ ᏥᏌ ᎯᎠ ᏂᏚᏪᏎᎴᎢ:; ᏞᏍᏗ ᎢᏍᏘ"}
{"crop": "sn83020874_1829-08-05_ed-1_seq-3_P3_TL00184.png", "text": "ᏗᎥ. ᎠᏮᎢᏒᏃ ᎬᏂᏳᏉ ᎢᎦᏛ ᎠᏂᎦᏘᏯ ᎦᏚᎲ"}
{"crop": "sn83020874_1829-08-05_ed-1_seq-3_P3_TL00197.png", "text": "ᎤᏁᏅᏒᎩ ᏦᏓᎸ ᏥᏌ ᎤᎾᏎᎮᎸᎢ."}
{"crop": "sn83020874_1829-08-05_ed-1_seq-3_P3_TL00203.png", "text": "ᏣᏬᏍᎨᏍᏗ ᎢᏨᏗᏍᎨᏍᏗ ᎦᏁᎥ ᎡᎪᏓ ᎠᎴ ᎤᏪᏥ"}
{"crop": "sn83020874_1830-03-03_ed-1_seq-3_P3_TL00376.png", "text": "ᏂᎦᏛᏃ ᎤᏁᏅᏎ ᎠᏓᎦᏎᏍᏗᏱ. ᎠᏂᏏᏴᏫᎭ"}
{"crop": "sn83020874_1830-03-03_ed-1_seq-3_P3_TL00378.png", "text": ".Ꮞ ᏩᎣᏉᏃ ᏦᏩ ᎨᎳᎵ. ᎤᏂᎩᏎᎢ ᎾᏏᏢᏗ Ꭶ"}
{"crop": "sn83020874_1830-03-03_ed-1_seq-3_P3_TL00387.png", "text": "ᏝᏰᏃ ᏳᎪᏅᏕᎦ.- ᎠᏒᏍᏗᏱ ᎠᏓᏁᎸᎢ,"}
{"crop": "sn83020874_1830-03-03_ed-1_seq-3_P3_TL00390.png", "text": "ᎬᏂᎭᏉᏃ ᏗᏂᎿᏩᏗᎪᎯ ᏱᎨᏩ ᎤᏈᎵᎦ"}
{"crop": "sn83020874_1830-03-03_ed-1_seq-3_P3_TL00391.png", "text": "ᎥᏥᏌᏤᎴᎢ: ᎤᏣᏓᏟᎯᏃ ᎤᏂᏍᎦᎴᎢ"}
{"crop": "sn83020874_1830-03-03_ed-1_seq-3_P3_TL00400.png", "text": "ᎩᎳᏉᏃ ᎢᎠᏛ ᎤᏂᏣᎶᏘ ᏮᎸᎳᏗ ᎠᏁᎯ"}
{"crop": "sn83020874_1831-01-08_ed-1_seq-3_P3_TL00435.png", "text": "ᏓᏣᏓᎴᏅᎯ ᎨᏒᎢ; ᏝᏰᏃ ᎩᎶ ᎯᎠ- ᎤᏍᏆᏂᎪᏗ ᏥᏑ"}
{"crop": "sn83020874_1831-01-08_ed-1_seq-3_P3_TL00445.png", "text": "ᏥᏌ ᎤᏁᏨᎩ; ᎤᎪᎯᏳᎯᏯ ᎤᎪᎯᏳᎯᏯ"}
{"crop": "sn83020874_1831-01-08_ed-1_seq-3_P3_TL00448.png", "text": "Ꮾ ᎤᏇᏓᏢ ᎤᎾᏄᎪᏫᏒ ᎤᏇᏓᏢᏉ ᎲᎭᎢ; ᎠᏓᏃ"}
{"crop": "sn83020874_1831-01-08_ed-1_seq-3_P3_TL00453.png", "text": "ᏛᎩᏍᎪᎢ ᎠᏎᏃ Ꮭ ᏱᎦᏓᎰ ᏗᎦᏛ ᎠᎴ ᏩᎦᏛ; Ꮹ"}
{"crop": "sn83020874_1831-01-08_ed-1_seq-3_P3_TL00461.png", "text": ".ᎣᏥᎦᏓᎲ ᎣᏥᏁᎪᎢ, ᎠᎴ ᎣᎩᎪᎲᎯ ᎣᏥᏃᎮᏍᎪᎢ;"}
{"crop": "sn83020874_1831-01-08_ed-1_seq-3_P3_TL00465.png", "text": "“ᏳᏔᎲᎦ ᎦᏄᎳᏗ ᏂᎦᎵᏍᏓᏂᎪᎲ ᏱᏨᏃᏢᎮᎸ."}
{"crop": "sn83020874_1831-01-08_ed-1_seq-3_P3_TL00484.png", "text": "ᎯᎠᏃ ᎢᏨᏍᏗ ᎤᏂᏍᎦᏅᏨ ᏥᏚᏮᏚᎪᎿᏁᎩ”"}
{"crop": "sn83020874_1831-01-22_ed-1_seq-3_P3_TL00478.png", "text": "ᏗᏍᏇᏲᏂᎲᏍᎩ ᎣᏥᎦᏔᎭ ᏔᏕᏲᏂᎲᏍᎩ ᎤᏁᎳᏅᎯ"}
{"crop": "sn83020874_1831-01-22_ed-1_seq-3_P3_TL00491.png", "text": "ᎡᎯ ᏱᎩ, ᎥᏝ ᏴᎬᏴᎭ ᎤᏁᎳᏅᎯ ᎤᏤᎵᎪᎯ."}
{"crop": "sn83020874_1831-01-22_ed-1_seq-3_P3_TL00493.png", "text": "ᏬᎪᏃ ᎤᎾᏄᎪᏫᎧᏒ ᎠᏓᏅᎪ ᎨᏐᎢ."}
{"crop": "sn83020874_1831-01-22_ed-1_seq-3_P3_TL00499.png", "text": "-.Ꭿ ᏂᎦᏘᎹᏏ ᎤᏁᎾ ᎯᎠ ᏄᏪᏎᎴᎢ; ᎦᎪᏃ ᏱᎨ"}
{"crop": "sn83020874_1831-01-22_ed-1_seq-3_P3_TL00505.png", "text": "ᎣᏥᎦᏓᎲ ᎣᏥᏁᎪᎢ; ᎠᎴ ᎣᎩᎪᎲᎯ. ᎣᏥᏃᎮᏍᎪᎢ;Ꮆ"}
{"crop": "sn83020874_1831-01-22_ed-1_seq-3_P3_TL00509.png", "text": "ᏳᎲᎦ ᎦᎸᎳᏗ ᏂᎦᏢᏍᏓᏂᎪᎲ ᏱᏨᏃᏢᎮᎸ."}
{"crop": "sn83020874_1831-01-22_ed-1_seq-3_P3_TL00521.png", "text": "ᎤᏁᎳᏅᎯᏰᏃ ᎤᏪᏥ ᎡᎶᎯ ᏧᏅᎫᏒ Ꮭ ᎡᎶᏊ"}
{"crop": "sn83020874_1831-01-22_ed-1_seq-3_P3_TL00532.png", "text": "ᎩᎶᏰᏃ ᎤᏲ ᎫᎸᏫᏍᏓᏁᎯ ᎠᏍᎦᎪ ᎢᎦ"}
{"crop": "sn83020874_1831-01-29_ed-1_seq-3_P3_TL00323.png", "text": "3.”ᏣᏍᎩ ᏥᏔᎤᎷᏤᎸ ᏒᏃᏱ.ᏊᎠ ᏄᏪᏎᎸᎩ;"}
{"crop": "sn83020874_1831-01-29_ed-1_seq-3_P3_TL00325.png", "text": "ᏖᏣᏓᎴᏅᎯ. ᎨᏒᎢ; ᏝᏰᏃ ᎩᎶ-ᎯᎠ ᎤᏍᏆᏂᎪᏘ Ꮒ"}
{"crop": "sn83020874_1831-01-29_ed-1_seq-3_P3_TL00328.png", "text": "““Ꮜ ᎤᏁᏨ ᎯᎠ” ᏄᏪᏎᎸᎩ; ᎤᎪᎯᏳᎯᏯ,"}
{"crop": "sn83020874_1831-01-29_ed-1_seq-3_P3_TL00347.png", "text": "ᏞᏌ ᎤᏁᏊᏨ ᎯᎠ ᏄᏪᏎᎸᎩ: ᎥᎲᎪ ᏓᏡᏲᎲ"}
{"crop": "sn83020874_1831-01-29_ed-1_seq-3_P3_TL00352.png", "text": "ᎠᏎᏃ Ꮭ ᏱᎬᎯᏳᎲᏍᎪ ᎣᏥᏃᎮᏍᎬᎢ."}
{"crop": "sn83020874_1831-01-29_ed-1_seq-3_P3_TL00356.png", "text": "ᏝᏰᏃ ᎩᎶ ᎦᎸᎳᏁ ᏫᏳᎶᏐᎭ ᎦᎸᎳᏗ ᏓᏳ”"}
{"crop": "sn83020874_1831-01-29_ed-1_seq-3_P3_TL00365.png", "text": "ᏓᏍᏘ ᎤᏲᎱᏒ ᎬᏂᏛᏉᏍᎩᏂ ᎤᏣᏛᏗ, ᎭᏱᏗ Ꮕ"}
{"crop": "sn83020874_1831-01-29_ed-1_seq-3_P3_TL00376.png", "text": "ᎤᏢᏏᎩ ᎡᏍᎦᏚᏉ ᎢᎦᎦᏁ, ᏚᏂᎸᏫᏍᏓᏁᎲᏰᏃ ᎤᏂᎢᏳ,"}
{"crop": "sn83020874_1831-04-09_ed-1_seq-3_P3_TL00617.png", "text": "ᏞᏍᏗ ᏣᏃᏍᎩᏒᎩ."}
