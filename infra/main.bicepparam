// Parameters for infra/main.bicep, from the environment's settings
// (.azure/<env>/.env). scripts/bootstrap.sh exports the settings that have
// a value before it deploys the stack; the rest take the defaults here.
using './main.bicep'

import { checkedEnvName } from 'naming.bicep'

// prod, dev or x plus 1-4 lowercase letters or digits (ADR-0017); any
// other name fails here, at build-params time.
param environmentName = checkedEnvName(readEnvironmentVariable('AZURE_ENV_NAME'))
param location = readEnvironmentVariable('AZURE_LOCATION', 'eastus2')
// No default: the VNet's private address space is a setting, never committed.
param vnetAddressPrefix = readEnvironmentVariable('USNM_VNET_ADDRESS_PREFIX')
param apiMaxReplicas = int(readEnvironmentVariable('USNM_API_MAX_REPLICAS', '2'))
param computeConcurrency = int(readEnvironmentVariable('USNM_COMPUTE_CONCURRENCY', '2'))
param apiImage = readEnvironmentVariable('USNM_API_IMAGE', '')
param searchBackend = readEnvironmentVariable('USNM_SEARCH_BACKEND', 'fixtures')
param searcherApp = bool(readEnvironmentVariable('USNM_SEARCHER_APP', 'false'))
param searcherAppRetain = bool(readEnvironmentVariable('USNM_SEARCHER_APP_RETAIN', 'false'))
param indexStorage = bool(readEnvironmentVariable('USNM_INDEX_STORAGE', 'false'))
param indexStorageServe = bool(readEnvironmentVariable('USNM_INDEX_STORAGE_SERVE', 'false'))
param lakeBlobSoftDeleteDays = int(readEnvironmentVariable('USNM_LAKE_BLOB_SOFT_DELETE_DAYS', '3'))
param ingestJobs = bool(readEnvironmentVariable('USNM_INGEST_JOBS', 'false'))
param useAcr = bool(readEnvironmentVariable('USNM_USE_ACR', 'false'))
param imageTag = readEnvironmentVariable('USNM_IMAGE_TAG', 'main')
param apiImageTag = readEnvironmentVariable('USNM_API_IMAGE_TAG', readEnvironmentVariable('USNM_IMAGE_TAG', 'main'))
param scheduledIngestImageTag = readEnvironmentVariable('USNM_SCHEDULED_INGEST_IMAGE_TAG', readEnvironmentVariable('USNM_IMAGE_TAG', 'main'))
param ingestCron = readEnvironmentVariable('USNM_INGEST_CRON', '')
param ingestFull = bool(readEnvironmentVariable('USNM_INGEST_FULL', 'false'))
param americanStories = bool(readEnvironmentVariable('USNM_AMERICAN_STORIES', 'false'))
param americanStoriesSearch = bool(readEnvironmentVariable('USNM_AMERICAN_STORIES_SEARCH', 'true'))
param congressSearch = bool(readEnvironmentVariable('USNM_CONGRESS_SEARCH', 'true'))
param pageLanguageFilter = readEnvironmentVariable('USNM_PAGE_LANGUAGE_FILTER', '')
param browsePages = bool(readEnvironmentVariable('USNM_BROWSE_PAGES', 'false'))
param congress = bool(readEnvironmentVariable('USNM_CONGRESS', 'false'))
param congressJob = bool(readEnvironmentVariable('USNM_CONGRESS_JOB', 'false'))
param serialSetJob = bool(readEnvironmentVariable('USNM_SERIALSET_JOB', 'false'))
param serialSetOnPrem = bool(readEnvironmentVariable('USNM_SERIALSET_ONPREM', 'false'))
param serialSetRunner = readEnvironmentVariable('USNM_SERIALSET_RUNNER', '')
param boincHandoffRunner = readEnvironmentVariable('USNM_BOINC_HANDOFF_RUNNER', '')
param boincControllerOnPrem = bool(readEnvironmentVariable('USNM_BOINC_CONTROLLER_ONPREM', 'false'))
param boincHandoffImage = readEnvironmentVariable('USNM_BOINC_HANDOFF_IMAGE', '')
param jaLatin = bool(readEnvironmentVariable('USNM_JA_LATIN', 'false'))
param ocrLocal = bool(readEnvironmentVariable('USNM_OCR_LOCAL', 'false'))
param partitionDecade = bool(readEnvironmentVariable('USNM_PARTITION_DECADE', 'false'))
param singleTextField = bool(readEnvironmentVariable('USNM_SINGLE_TEXT_FIELD', 'false'))
param pageLanguage = bool(readEnvironmentVariable('USNM_PAGE_LANGUAGE', 'false'))
param splitDocs = int(readEnvironmentVariable('USNM_SPLIT_DOCS', '0'))
param writerIngest = readEnvironmentVariable('USNM_WRITER_INGEST', 'v2')
param dedicatedProfile = bool(readEnvironmentVariable('USNM_DEDICATED_PROFILE', 'false'))
param ingestOnDedicated = bool(readEnvironmentVariable('USNM_INGEST_ON_DEDICATED', 'false'))
param archiveAccountId = readEnvironmentVariable('USNM_ARCHIVE_ACCOUNT', '')
param retainRaw = bool(readEnvironmentVariable('USNM_RETAIN_RAW', 'false'))
param backfillWorkers = int(readEnvironmentVariable('USNM_BACKFILL_WORKERS', '4'))
param backfillCron = readEnvironmentVariable('USNM_BACKFILL_CRON', '')
param ingestScratchGiB = int(readEnvironmentVariable('USNM_INGEST_SCRATCH_GIB', '0'))
param ingestMergeTimeoutSecs = int(readEnvironmentVariable('USNM_MERGE_TIMEOUT_SECS', '14400'))
param cosmosFreeTier = bool(readEnvironmentVariable('USNM_COSMOS_FREE_TIER', 'true'))
param logDailyCapGb = readEnvironmentVariable('USNM_LOG_DAILY_CAP_GB', '')
param alertEmails = readEnvironmentVariable('USNM_ALERT_EMAILS', '')
param searchLogReaders = readEnvironmentVariable('USNM_SEARCH_LOG_READERS', '')
param ocr = bool(readEnvironmentVariable('USNM_OCR', 'false'))
param ocrSku = readEnvironmentVariable('USNM_OCR_SKU', 'F0')
param ocrUsers = readEnvironmentVariable('USNM_OCR_USERS', '')
param deployBoincGroup = bool(readEnvironmentVariable('USNM_BOINC_GROUP', 'false'))
param ocrNodes = bool(readEnvironmentVariable('USNM_OCR_NODES', 'false'))
param ocrNodeIps = readEnvironmentVariable('USNM_OCR_NODE_IPS', '')
param ocrNodeGroupId = readEnvironmentVariable('USNM_OCR_NODE_GROUP', '')
param onPremGroupId = readEnvironmentVariable('USNM_ONPREM_GROUP', '')
param scanArchiveUploaderId = readEnvironmentVariable('USNM_SCAN_ARCHIVE_UPLOADER_ID', '')
param ocrKeyVaultAdmins = readEnvironmentVariable('USNM_OCR_KEYVAULT_ADMINS', '')
param ocrSyncCron = readEnvironmentVariable('USNM_OCR_SYNC_CRON', '17 * * * *')
param ocrUserDailyMax = int(readEnvironmentVariable('USNM_OCR_USER_DAILY_MAX', '1000'))
param ocrSeed = {
  USNM_OCR_SEED_PLAN: readEnvironmentVariable('USNM_OCR_SEED_PLAN', '')
  USNM_OCR_SEED_BATCHES: readEnvironmentVariable('USNM_OCR_SEED_BATCHES', '')
  USNM_OCR_SEED_LANGUAGES: readEnvironmentVariable('USNM_OCR_SEED_LANGUAGES', '')
  USNM_OCR_SEED_YEARS: readEnvironmentVariable('USNM_OCR_SEED_YEARS', '')
  USNM_OCR_SEED_MIN_DAMAGE: readEnvironmentVariable('USNM_OCR_SEED_MIN_DAMAGE', '')
  USNM_OCR_SEED_MAX_PAGES: readEnvironmentVariable('USNM_OCR_SEED_MAX_PAGES', '')
  USNM_OCR_SEED_PILOT: readEnvironmentVariable('USNM_OCR_SEED_PILOT', '')
  USNM_OCR_SEED_SKIP_AMERICAN_STORIES: readEnvironmentVariable('USNM_OCR_SEED_SKIP_AMERICAN_STORIES', '')
  USNM_OCR_SEED_SOURCE: readEnvironmentVariable('USNM_OCR_SEED_SOURCE', '')
  USNM_OCR_SEED_MANIFEST: readEnvironmentVariable('USNM_OCR_SEED_MANIFEST', '')
  USNM_OCR_BULK_WINDOW: readEnvironmentVariable('USNM_OCR_BULK_WINDOW', '')
  USNM_OCR_BULK_REFILL_BELOW: readEnvironmentVariable('USNM_OCR_BULK_REFILL_BELOW', '')
}
param jaOcrJob = bool(readEnvironmentVariable('USNM_JA_OCR_JOB', 'false'))
param jaOcrReplicas = int(readEnvironmentVariable('USNM_JA_OCR_REPLICAS', '2'))
param searchCluster = bool(readEnvironmentVariable('USNM_SEARCH_CLUSTER', 'false'))
param searchClusterNodes = int(readEnvironmentVariable('USNM_SEARCH_CLUSTER_NODES', '1'))
param searchClusterIndexers = int(readEnvironmentVariable('USNM_SEARCH_CLUSTER_INDEXERS', '1'))
param searchClusterNodeVcpu = int(readEnvironmentVariable('USNM_SEARCH_CLUSTER_NODE_VCPU', '2'))
param searchClusterSplitSearches = int(readEnvironmentVariable('USNM_SEARCH_CLUSTER_SPLIT_SEARCHES', '0'))
param searchClusterRuntimeThreads = int(readEnvironmentVariable('USNM_SEARCH_CLUSTER_RUNTIME_THREADS', '0'))
param searchClusterSearchThreads = int(readEnvironmentVariable('USNM_SEARCH_CLUSTER_SEARCH_THREADS', '0'))
param searchCompareTags = readEnvironmentVariable('USNM_SEARCH_COMPARE_TAGS', '')
param searchLocalMode = readEnvironmentVariable('USNM_SEARCH_LOCAL_MODE', '')
param searchLocalIndex = readEnvironmentVariable('USNM_SEARCH_LOCAL_INDEX', '')
param searchLocalCacheGib = int(readEnvironmentVariable('USNM_SEARCH_LOCAL_CACHE_GIB', '40'))
param searchNfsGiB = int(readEnvironmentVariable('USNM_SEARCH_NFS_GIB', '64'))
param budgetStartDate = readEnvironmentVariable('USNM_BUDGET_START', '')
param dnsZoneName = readEnvironmentVariable('USNM_DNS_ZONE', '')
// Google Search Console domain verification, published at the apex next to SPF.
param dnsApexTxtValues = {
  'usnewsmap.com': ['google-site-verification=5KCwOzVrZH4QvucrU0UkbqJ1I1jYmjkKNnUuy78VTWg']
}
param availabilityFrequency = readEnvironmentVariable('USNM_AVAILABILITY_FREQUENCY', '900')
param apiCertificateId = readEnvironmentVariable('USNM_API_CERT_ID', '')
param siteCertificateId = readEnvironmentVariable('USNM_SITE_CERT_ID', '')
param wwwCertificateId = readEnvironmentVariable('USNM_WWW_CERT_ID', '')
param experiment = readEnvironmentVariable('USNM_EXPERIMENT', '')
param experimentStarted = readEnvironmentVariable('USNM_EXPERIMENT_STARTED', '')
param githubRepo = readEnvironmentVariable('USNM_GITHUB_REPO', 'tgoodyear/usnewsmap.com')
param githubRepoIds = readEnvironmentVariable('USNM_GITHUB_REPO_IDS', 'tgoodyear@116683/usnewsmap.com@1389862972')
