{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION=eastus2}" },
    "apiImage": { "value": "${USNM_API_IMAGE=}" },
    "searchBackend": { "value": "${USNM_SEARCH_BACKEND=fixtures}" },
    "ingestJobs": { "value": "${USNM_INGEST_JOBS=false}" },
    "useAcr": { "value": "${USNM_USE_ACR=false}" },
    "imageTag": { "value": "${USNM_IMAGE_TAG=main}" },
    "ingestCron": { "value": "${USNM_INGEST_CRON=}" },
    "backfillWorkers": { "value": "${USNM_BACKFILL_WORKERS=8}" },
    "cosmosFreeTier": { "value": "${USNM_COSMOS_FREE_TIER=true}" },
    "alertEmails": { "value": "${USNM_ALERT_EMAILS=}" },
    "budgetStartDate": { "value": "${USNM_BUDGET_START=}" }
  }
}
