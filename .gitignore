/target
**/*.rs.bk
.env
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/
web/*.tsbuildinfo
.azure
__pycache__/

# Private operator credentials/staging; interrupted runs require local cleanup.
.boinc-acceptance-*
.boinc-provision-*
.boinc-work-*
.origin-tls-work/
.origin-tls-test-*/
.origin-tls-role.json
.origin-tls-vault-*.json

# Data assets live in GitHub releases and are fetched in place by scripts/ops/data-assets.sh
# (ops/data-assets.json, docs/reports/README.md); the sets are these kinds of files.
docs/reports/**/*.csv
docs/reports/**/*.json
docs/reports/**/*.jsonl
# The line jobs' page list (#1621), a small inventory the runbook reads.
!docs/reports/2026-11-cherokee/phoenix-pages.jsonl
# The Advocate holdings counts (#1623), 43 lines.
!docs/reports/2026-11-cherokee/advocate-holdings.jsonl
# The lines and word boxes loaded on check.usnewsmap.com's Phoenix sets, which the scorer and `usnm-glyphs add-checked` read.
!docs/reports/2026-11-cherokee/check-lines-manifest.jsonl
!docs/reports/2026-11-cherokee/check-glyph-index.jsonl
docs/reports/**/*.parquet
docs/reports/**/*.txt
docs/reports/**/*.gz
docs/reports/**/*.pdf
docs/reports/**/*.tar
# The cumulative archive's rights notice and inventory stay in the tree.
!docs/reports/report-data-rights.txt
!docs/reports/report-data-manifest.json
docs/data/*
ocr/bench/**/*.jpg
ocr/bench/**/*.jpeg
ocr/bench/**/*.png
ocr/bench/**/*.tar.gz
ocr/bench/**/*.tgz
web/public/basemap/
