FROM pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime@sha256:417bd75df6365104c283ea4c1651fb3530d9eb5a4c2fafa51943cff2a94e6385
COPY ocr/boinc/train/requirements.txt ocr/boinc/train/constraints.txt /opt/train/
RUN pip install --no-cache-dir -r /opt/train/requirements.txt -c /opt/train/constraints.txt \
 && pip check
COPY ocr/boinc/train/ /opt/train/
COPY scripts/ocr-survey/transcription.py scripts/ocr-survey/gold.py /usr/local/lib/usnm-boinc/gold/scripts/ocr-survey/
RUN python /opt/train/download_model.py --out /opt/base
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 TOKENIZERS_PARALLELISM=false HOME=/tmp \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /work
ENTRYPOINT []
CMD ["python", "/opt/train/worker.py", "--dir", "/work"]
