# The usnm_iris worker image (#703, plan class docker_intel_opencl_4b): Qwen3-VL-4B-Instruct INT4 on
# OpenVINO GenAI 2026.4.1, on an Intel Iris Xe GPU through Intel's OpenCL runtime. One pre-cropped
# newspaper JPEG per BOINC unit; the stock docker_wrapper mounts the slot at /work and passes only
# /dev/dri/renderD128 (job.toml create_args, no use_gpu). No CPU fallback, no network, no downloads
# at run time: the model is in the image, checked file by file against model.lock.
#
# Everything is pinned: the Debian base by digest, Debian packages by a snapshot.debian.org date
# (apt checks them against the archive's signed Release files), Intel's .debs and the licence text
# by sha256 (runtime.lock), Python wheels by sha256 (requirements.lock), and the model's files by
# size and sha256 (model.lock, whose digest is contract.MODEL_MANIFEST_SHA256).
#
# Build from the repository root (linux/amd64):
#   docker build -f ocr/boinc/iris/Containerfile -t usnm-boinc-iris .
ARG DEBIAN=debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
ARG SNAPSHOT=20261015T000000Z

FROM ${DEBIAN} AS base
ARG SNAPSHOT
RUN rm -f /etc/apt/sources.list.d/debian.sources \
 && printf '%s\n' \
    "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${SNAPSHOT} trixie main" \
    "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${SNAPSHOT} trixie-updates main" \
    "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/${SNAPSHOT} trixie-security main" \
    > /etc/apt/sources.list \
 && printf 'Acquire::Retries "5";\nAcquire::http::Timeout "60";\n' > /etc/apt/apt.conf.d/80-retries

FROM base AS fetch
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY ocr/boinc/iris/model.lock ocr/boinc/iris/runtime.lock /locks/
RUN set -eu; mkdir -p /out/model /out/debs; \
    grep -v '^#' /locks/runtime.lock | while read -r sum url name; do \
      case "$name" in LICENSE) dest=/out/LICENSE;; *.deb) dest="/out/debs/$name";; *) exit 1;; esac; \
      curl -fsSL --proto '=https' --retry 5 --retry-all-errors --retry-delay 2 -o "$dest" "$url"; \
      echo "$sum  $dest" | sha256sum -c --quiet -; \
    done
ARG MODEL_REPO=OpenVINO/Qwen3-VL-4B-Instruct-int4-ov
ARG MODEL_REVISION=3ffb805d532a250e5010c5aa5ce6579e60b31d71
RUN set -eu; grep -v '^#' /locks/model.lock | while read -r sum size path; do \
      curl -fsSL --proto '=https' --retry 5 --retry-all-errors --retry-delay 2 -o "/out/model/$path" \
        "https://huggingface.co/$MODEL_REPO/resolve/$MODEL_REVISION/$path"; \
      test "$(stat -c %s "/out/model/$path")" = "$size"; \
      echo "$sum  /out/model/$path" | sha256sum -c --quiet -; \
    done; \
    test "$(ls -A /out/model | wc -l)" = "$(grep -vc '^#' /locks/model.lock)" || { echo "model files differ from model.lock" >&2; exit 1; }

FROM base
ARG BUILD_REVISION=unknown
LABEL org.usnewsmap.iris.app="usnm_iris" org.usnewsmap.iris.plan-class="docker_intel_opencl_4b"
COPY --from=fetch /out/debs/ /opt/iris/debs/
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      python3 python3-venv ocl-icd-libopencl1 /opt/iris/debs/*.deb \
 && rm -rf /var/lib/apt/lists/* /opt/iris/debs \
 && test -f /etc/OpenCL/vendors/intel.icd \
 && dpkg-query -W -f '${Package} ${Version}\n' > /opt/iris/dpkg.txt
COPY ocr/boinc/iris/requirements.lock /opt/iris/requirements.lock
RUN python3 -m venv /opt/iris/venv \
 && /opt/iris/venv/bin/pip install --no-cache-dir --disable-pip-version-check --require-hashes --no-deps \
      --only-binary=:all: -r /opt/iris/requirements.lock \
 && /opt/iris/venv/bin/pip uninstall -y --disable-pip-version-check pip \
 && test ! -e /opt/iris/venv/bin/pip
COPY --from=fetch /out/model/ /opt/iris/model/
COPY --from=fetch /out/LICENSE /opt/iris/LICENSE
COPY ocr/boinc/iris/model.lock ocr/boinc/iris/runtime.lock ocr/boinc/iris/NOTICE /opt/iris/
COPY ocr/boinc/iris/contract.py ocr/boinc/iris/bundle.py ocr/boinc/iris/worker.py /opt/iris/app/
# The image's model is the contract's: the manifest digest, every file's name and size, and the
# pinned engine version, checked offline (there is no GPU at build time).
RUN /opt/iris/venv/bin/python -I -c 'import sys; sys.path.insert(0, "/opt/iris/app"); \
import contract as c, worker as w, openvino, openvino_genai, PIL; \
assert openvino.__version__.startswith(c.OPENVINO_VERSION), openvino.__version__; \
print(c.MODEL_MANIFEST_SHA256, w.check_model(w.Paths()), openvino.__version__, openvino_genai.__version__)' \
 && /opt/iris/venv/bin/python -m compileall -q /opt/iris/app
# HOME and the OpenCL compiler cache stay off the read-only root (create_args mount /tmp as tmpfs).
ENV HOME=/tmp PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 NEO_CACHE_PERSISTENT=0 \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 OPENVINO_TELEMETRY_DISABLED=1 \
    USNM_IRIS_BUILD_REVISION=${BUILD_REVISION} \
    USNM_IRIS_MODEL_MANIFEST=sha256:f12e4fc8498cbe5454212ae843805a9afbd64028472a2c6778cffd0b1967ac8e
HEALTHCHECK NONE
WORKDIR /work
ENTRYPOINT []
CMD ["/opt/iris/venv/bin/python", "-I", "/opt/iris/app/worker.py"]
