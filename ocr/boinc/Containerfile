# Build with the existing Tesseract image's immutable digest. Model bytes
# and routing are shared with the on-prem worker; no nested container runtime.
# TESSERACT_IMAGE is the engine's image id (sha256:...), recorded in the image.
# TESSERACT_FROM is what FROM resolves, by default the same: BuildKit can't
# resolve a bare local image id, so a Docker build passes the engine's local
# tag here (.github/workflows/boinc-worker.yml checks it is that image).
ARG TESSERACT_IMAGE
ARG TESSERACT_FROM=${TESSERACT_IMAGE}
ARG RUST_IMAGE=rust:1-bookworm
FROM ${RUST_IMAGE} AS build
ARG BUILD_JOBS=2
WORKDIR /src
COPY . .
RUN cargo build --release --locked --jobs "$BUILD_JOBS" -p usnm-boinc --bin usnm-boinc --example pilot_fixture

FROM ${TESSERACT_FROM}
# The assessment (#456) checks each unit against the engine image this one is built on.
ARG TESSERACT_IMAGE
ENV USNM_TESSERACT_IMAGE=${TESSERACT_IMAGE}
# The base's package sources are already pinned to its Debian snapshot.
USER 0
RUN apt-get -o Acquire::Check-Valid-Until=false update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends procps \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/usnm-boinc /usr/local/bin/usnm-boinc
# Stock docker_wrapper mounts a BOINC-owned slot at /work. job.toml drops
# capabilities except DAC_OVERRIDE so UID 0 can access that foreign-owned
# mount. Only the slot is mounted; outputs are mode 0644 for the host client.
ENTRYPOINT []
CMD ["/usr/local/bin/usnm-boinc", "work", "--dir", "/work"]
