# Image for the per-word script detection tools (#1666): Tesseract with eng, Python with numpy,
# scipy, Pillow, scikit-learn and PyTorch (CPU). The syllabary models (chr, chr_phoenix) are mounted with --tessdata.
#   podman build -t usnm-script-detect -f ocr/script-detect/Containerfile ocr/script-detect
FROM docker.io/library/debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-numpy python3-scipy \
        python3-pil python3-sklearn python3-torch tesseract-ocr tesseract-ocr-eng zstd ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
