# Hourly pipeline counters for the OCR dashboard's step throughput panel (#704): one of the
# controller, ship and boinc sources on the host that has it, as
# /usr/local/bin/usnm-throughput-collect (scripts/ocr-node/throughput-collect.py). Reads journals
# and, for boinc, two bounded aggregate queries; changes nothing. Settings in
# /etc/usnm/throughput-collect.env: USNM_THROUGHPUT_SOURCE, USNM_THROUGHPUT_HOURS and
# USNM_THROUGHPUT_PUSH_URL (http://<dashboard>/api/throughput/<source>).
[Unit]
Description=usnewsmap step throughput counters for the OCR dashboard (#704)
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=/usr/local/bin/usnm-throughput-collect

[Service]
Type=oneshot
EnvironmentFile=/etc/usnm/throughput-collect.env
ExecStart=/usr/local/bin/usnm-throughput-collect --source ${USNM_THROUGHPUT_SOURCE} --hours ${USNM_THROUGHPUT_HOURS} --push-url ${USNM_THROUGHPUT_PUSH_URL}
TimeoutStartSec=2min
Nice=19
IOSchedulingClass=idle
MemoryMax=256M
