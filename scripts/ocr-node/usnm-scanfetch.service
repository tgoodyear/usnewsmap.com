# The scan prefetcher (#368), deployed by infrastructure tooling.
# It is the only process
# that fetches from LoC while it runs: `usnm-ocr-worker prefetch` with the
# worker's client and pacing, writing into /tank/ocr/scans, a bind mount
# of the host's tank/ocr/scans, and keeping batch manifests and issue METS
# in /tank/ocr/manifests/batches. Its settings are in /etc/usnm/scanfetch.env.
# It doesn't restart on failure: it stops after 20 pages from 3 titles
# fail in a row, which is how a block looks, and someone should look
# before it goes on. One title's broken items are skipped and asked again
# after a cool-off instead (#414).
[Unit]
Description=usnewsmap scan prefetch
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=/usr/local/bin/usnm-ocr-worker
RequiresMountsFor=/tank/ocr/scans /tank/ocr/manifests

[Service]
Type=simple
User=scanfetch
Group=scanfetch
EnvironmentFile=/etc/usnm/scanfetch.env
ExecStart=/usr/local/bin/usnm-ocr-worker prefetch
Restart=no
# SIGTERM: no new pages; the ones in flight finish.
KillSignal=SIGTERM
TimeoutStopSec=300
SyslogIdentifier=usnm-scanfetch
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/tank/ocr/scans
# Batch manifests and issue METS (#368); `-`: a container configured
# before the batch route starts without it.
ReadWritePaths=-/tank/ocr/manifests/batches
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
