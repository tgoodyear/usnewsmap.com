# The OCR dashboard (12 §12.2.5), deployed by infrastructure tooling:
# a read-only page of the scan
# fetch, the OCR nodes and the Proxmox hosts, for the LAN only. Its settings
# are in /etc/usnm/ocrdash.env; the copies of the workers' journals are in
# /var/lib/usnm-ocrdash.
[Unit]
Description=usnewsmap OCR dashboard
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=/usr/local/bin/usnm-ocrdash
RequiresMountsFor=/tank/ocr/scans /tank/ocr/manifests /srv/hoststats

[Service]
Type=simple
User=ocrdash
Group=ocrdash
EnvironmentFile=/etc/usnm/ocrdash.env
ExecStart=/usr/local/bin/usnm-ocrdash
# Reads the TLS certificate again (home-acme on the host runs this after a
# renewal).
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
SyslogIdentifier=usnm-ocrdash
StateDirectory=usnm-ocrdash
# Ports 80 and 443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
