# Daily, after the scan prefetcher has added more keep-set scans; the
# upload skips what is in the archive already, so a run with nothing new
# costs one properties read per scan.
[Unit]
Description=usnewsmap scan archive upload, daily

[Timer]
OnCalendar=*-*-* 04:30:00
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
