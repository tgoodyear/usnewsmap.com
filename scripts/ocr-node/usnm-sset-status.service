# Writes /var/lib/usnm-sset/status.json from usnm-sset.service's journal
# (scripts/ocr-node/sset-status.py, installed as /usr/local/bin/usnm-sset-status)
# and pushes it to the OCR dashboard (needs its --sset-push usnm-sset=<this node>).
[Unit]
Description=usnewsmap Serial Set fetch status file
ConditionFileIsExecutable=/usr/local/bin/usnm-sset-status

[Service]
Type=oneshot
EnvironmentFile=/etc/usnm/sset-status.env
ExecStartPre=/usr/bin/test -n ${USNM_SSET_STATUS_PUSH_URL}
ExecStart=/usr/local/bin/usnm-sset-status --unit usnm-sset.service --out /var/lib/usnm-sset/status.json --done /var/lib/usnm-sset/done --push-url ${USNM_SSET_STATUS_PUSH_URL}
StandardOutput=null
