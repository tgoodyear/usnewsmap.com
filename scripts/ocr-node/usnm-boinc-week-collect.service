# The BOINC week for the OCR dashboard: the last seven days in 3-hour buckets, on the BOINC
# server, as /usr/local/bin/usnm-boinc-week-collect (scripts/ocr-node/boinc-week-collect.py).
# Three bounded aggregate queries; changes nothing. Settings in /etc/usnm/boinc-week-collect.env:
# USNM_BOINC_WEEK_PUSH_URL (http://<dashboard>/api/boinc-week) and USNM_BOINC_WEEK_PROJECT_USERS
# (the project's own BOINC user ids, comma-separated, left out of the volunteer counts).
[Unit]
Description=usnewsmap BOINC week for the OCR dashboard
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=/usr/local/bin/usnm-boinc-week-collect

[Service]
Type=oneshot
EnvironmentFile=/etc/usnm/boinc-week-collect.env
ExecStart=/usr/local/bin/usnm-boinc-week-collect --push-url ${USNM_BOINC_WEEK_PUSH_URL} --project-users ${USNM_BOINC_WEEK_PROJECT_USERS}
TimeoutStartSec=2min
Nice=19
IOSchedulingClass=idle
MemoryMax=256M
