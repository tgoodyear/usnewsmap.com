# One color of the API and site in the serving container (#955):
# usnm-api@blue on 127.0.0.1:8081, usnm-api@green on 127.0.0.1:8082. Caddy
# forwards to one of them; update-api.sh starts the other on a new image,
# switches once its /readyz passes and then stops the old one. install.sh
# installs this unit as /etc/systemd/system/usnm-api@.service.
#
# /etc/usnm-serving/api.env (gen-env.sh) holds the settings both colors
# share. /etc/usnm-serving/api-<color>.env (update-api.sh) holds the
# color's own: API_IMAGE (the image by digest), API_COMMIT and USNM_BIND.
# host.env (install.sh) holds HIMDS_GID.
#
# Both colors share one response cache directory, so a new color's warm-up
# reads what the last color computed instead of computing it again. Sharing is
# safe: entries are keyed by index version and response format, and the API's
# local store adds a per-process random token to its temporary file names, so
# two colors can write at once even though both run the API as process 1.
# Sitemap checkpoints instead share a durable directory across colors. Their
# create-only store uses process-unique temporary names and atomic appends.
#
# The OCR ALTO copy (scripts/onprem/ocr-local-copy) is mounted read-only from
# the host, where home-infra's serving-ct.sh --alto-dir binds the dataset in.
# Its files are readable by group 2101 only, the copy's searchlog-readers
# group, which is why the unit adds that group. The page layout
# (/v1/pages/{doc_id}/layout) now reads the curated copy below instead:
# USNM_ALTO_URL=/srv/usnm-lake-t makes ocr-local/alto/ its path.
#
# Since the Azure exit (#1367, #2031) the API reads and writes the local
# lake instead of Blob storage: the reference (current.json and each
# version's files, read-only), the curated OCR ALTO (read-only), the search
# log and the OCR requests. The container host binds each dataset in under
# /srv/usnm-lake-t; gen-env.sh writes those paths into api.env. This unit
# used to need a drop-in (usnm-api@.service.d/azexit-lake.conf) for them;
# install.sh removes it.
#
# Host network, as on the BOINC host (docs/boinc/server/onprem.md), so the API
# reaches the searcher and the Arc agent's identity endpoint on loopback.
# The himds group reads the agent's challenge files. The stop timeout
# covers the search-log and OCR-request flushes, up to 10 s each.
[Unit]
Description=usnewsmap API and site, %i color (#955)
Wants=network-online.target usnm-searcher.service
After=network-online.target usnm-searcher.service
ConditionPathExists=/etc/usnm-serving/api-%i.env

[Service]
EnvironmentFile=/etc/usnm-serving/host.env
EnvironmentFile=/etc/usnm-serving/api-%i.env
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
ExecStartPre=-/usr/bin/podman rm -f usnm-api-%i
ExecStart=/usr/bin/podman run --rm --name usnm-api-%i --network host --pull never \
  --env-file /etc/usnm-serving/api.env -e USNM_BIND=${USNM_BIND} \
  -v /srv/usnm-serving/cache/shared:/srv/usnm-serving/cache \
  -v /srv/usnm-serving/sitemap-state:/srv/usnm-serving/sitemap-state \
  -v /srv/usnm-serving/word-feedback:/srv/usnm-serving/word-feedback \
  -v /srv/usnm-lake/ocr-local:/srv/usnm-lake/ocr-local:ro --group-add 2101 \
  -v /srv/usnm-lake-t/ocr-local:/srv/usnm-lake-t/ocr-local:ro \
  -v /srv/usnm-lake-t/reference:/srv/usnm-lake-t/reference:ro \
  -v /srv/usnm-lake-t/searches:/srv/usnm-lake-t/searches \
  -v /srv/usnm-lake-t/ocr-requests:/srv/usnm-lake-t/ocr-requests \
  -v /var/opt/azcmagent/tokens:/var/opt/azcmagent/tokens:ro --group-add ${HIMDS_GID} \
  --read-only --tmpfs /tmp:rw,size=64m --cap-drop all --security-opt no-new-privileges \
  --memory 2g --stop-timeout 40 ${API_IMAGE}
ExecStop=/usr/bin/podman stop -t 40 usnm-api-%i

[Install]
WantedBy=multi-user.target
