# The persistent response cache (#955), installed by install.sh as
# /etc/tmpfiles.d/usnm-serving.conf. In Azure a lifecycle rule deletes
# cache entries 14 days after they're written; here
# systemd-tmpfiles-clean.timer does, once a day. The age counts from the
# last write only (m for files, M for directories): by default tmpfiles
# also counts the last read, so an entry read often would never go.
# Entries are rebuilt on demand, so losing one costs only a slower search.
# The colors share one directory (usnm-api@.service says why), made here,
# owned by the API image's user. The per-color directories from before that
# keep their expiry until their entries have aged out.
d /srv/usnm-serving/cache/shared 0750 1000 1000 mM:14d
d /srv/usnm-serving/cache/blue 0750 1000 1000 mM:14d
d /srv/usnm-serving/cache/green 0750 1000 1000 mM:14d
# Durable lastmod checkpoints are shared across colors and must never expire.
d /srv/usnm-serving/sitemap-state 0750 1000 1000 -
