# Follows the image CI rolls out to prod (#955): update-api.sh, installed by
# install.sh as /usr/local/sbin/usnm-serving-update, run by
# usnm-serving-update.timer. A run that deploys takes up to about 17
# minutes (the image pull, up to 800 s for the new color's start and
# warm-up, then the old color's 130 s drain); the timer doesn't start
# another while one runs.
[Unit]
Description=usnewsmap API: follow the image prod runs (#955)
Wants=network-online.target
After=network-online.target usnm-searcher.service caddy.service

[Service]
Type=oneshot
EnvironmentFile=/etc/usnm-serving/host.env
ExecStart=/usr/local/sbin/usnm-serving-update --registry ${USNM_SERVING_REGISTRY}
SyslogIdentifier=usnm-serving-update
TimeoutStartSec=30min
