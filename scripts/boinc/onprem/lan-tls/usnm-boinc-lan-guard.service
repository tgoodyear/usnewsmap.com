[Unit]
Description=usnm BOINC: Apache's port 80 for loopback only (#1357)
# Reapplied whenever nftables.service flushes the ruleset.
After=nftables.service
PartOf=nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/usnm-boinc/lan-guard.nft
ExecStop=-/usr/sbin/nft delete table inet usnm_boinc_lan

[Install]
WantedBy=multi-user.target nftables.service
