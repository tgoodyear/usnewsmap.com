# Joins native batch-8 Qwen canonical readings with its same-campaign QUALITY jobs.
# ENGINE_IMAGE identifies the QUALITY scorer, not the Qwen model or native app.
[Unit]
Description=usnewsmap native Qwen canonical science into usnm_quality
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/usnm/quality-ship.env

[Service]
Type=oneshot
EnvironmentFile=/etc/usnm/quality-ship.env
Environment=CTID=215
# One --native-campaign NAME[=COLLECTOR] per root the feed writes (word-split on purpose). Roots at
# 3 and 4 need a build from #1437 on. A root's cache is keyed to its collector, so moving every root
# to one collector warms the moved roots first (docs/boinc-quality.md, "One submit binary and one
# collector"). Never name the server image's usnm-boinc, which every rebuild replaces.
Environment="NATIVE_QWEN_ARGS=--native-campaign qwen-nonenglish-v1"
Environment=QUALITY_COLLECTOR=/project/ops/quality-results/usnm-boinc
# Before the validator runs crop-consensus-v2 (#1434), and once every collector named above is from
# #1434 on: CROP_STATES_ARGS="--qwen-crop-states /project/usnmocr/qwen/crop-states", so only
# the crops an agreeing pair vouched for join.
Environment=CROP_STATES_ARGS=
# Once a root is staged with bundles (#1435), and every collector named above is from #1435 on:
# QWEN_PAGES_ARGS="--qwen-pages /project/usnmocr/qwen/pages", so a bundle with no canonical result
# joins the pages a pair agreed on. It changes only bundles' keys.
Environment=QWEN_PAGES_ARGS=
EnvironmentFile=-/etc/usnm/quality-results.env
EnvironmentFile=-/etc/usnm/quality-results-qwen.env
ExecStart=/usr/bin/python3 /opt/usnm-quality-feed/quality_results.py $NATIVE_QWEN_ARGS $CROP_STATES_ARGS $QWEN_PAGES_ARGS --engine-image ${ENGINE_IMAGE} --ctid ${CTID} --incremental --collector ${QUALITY_COLLECTOR} --step-lock-wait-secs 60
# A root can take about 30 minutes at worst, and there are three.
TimeoutStartSec=100min
Nice=10
