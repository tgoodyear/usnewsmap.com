[Unit]
Description=Non-English damage-first Qwen scan manifests
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/usnm/quality-db/dsn

[Service]
Type=oneshot
Environment=LC_ALL=C.UTF-8
EnvironmentFile=/etc/usnm/quality-build.env
ExecStart=/usr/bin/flock -n /run/usnm-qwen-manifest.lock /bin/sh -c 'exec /opt/usnm-quality-feed/venv/bin/python /opt/usnm-quality-feed/ocr_manifest.py build-quality \
  --non-english --state /var/lib/usnm-ocr-manifest/qwen-nonenglish \
  --dsn "$(cat /etc/usnm/quality-db/dsn)" --max-pages 1000 --scan-server "$SCAN_SERVER"'
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=2h
