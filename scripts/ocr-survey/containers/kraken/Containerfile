# Kraken OCR (blla baseline segmenter + recognition models) for the engine survey.
# Build from scripts/ocr-survey:
#   podman build -f containers/kraken/Containerfile -t ocr-survey/kraken .
FROM mirror.gcr.io/library/debian:trixie-slim@sha256:918311b7b6c4c6f68b232ba516584925f6c78ad82b6fd534b98979df6438e483

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv python3-pil libglib2.0-0 libgl1 \
 && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu \
      torch torchvision kraken pillow lxml

ENV PATH="/opt/venv/bin:$PATH" KRAKEN_MODELS=/opt/models/kraken OMP_NUM_THREADS=4
COPY engine_runner.py altotext.py /opt/survey/
ENTRYPOINT ["/opt/venv/bin/python", "/opt/survey/engine_runner.py", "--engine", "kraken"]
