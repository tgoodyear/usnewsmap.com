ocr/bench/serialset-pilot/source/alto/*.xml whitespace=cr-at-eol
fixtures/congress/lcg/manual/annals/*.pdf binary
# The native Qwen app embeds these byte for byte (include_bytes!) and compares them with the
# copies shipped beside it, so every checkout, Windows CI included, must keep LF.
boinc/apps/qwen/*.lock text eol=lf
boinc/apps/qwen/*.json text eol=lf
# The Surya image's pins: usnm-boinc compiles one in (include_str!) and a build passes each line to
# `docker build --build-arg`, where a carriage return would be part of the value.
boinc/apps/surya/engine.lock text eol=lf
# The picture baseline checks the bundled provenance's exact SHA256.
scripts/pictures/newspaper-navigator-baseline.lock.json text eol=lf
# The Fraktur pilot's SHA256SUMS covers these files' exact bytes.
ocr/fraktur-pilot/*.json text eol=lf
ocr/fraktur-pilot/*.jsonl text eol=lf
ocr/fraktur-pilot/SHA256SUMS text eol=lf
# The reviewed German trust hold (#835): a test checks it byte for byte (include_bytes!) and its
# sha256 is the one to verify after installing it on the BOINC server.
docs/notes/2026-11-05-german-trust-hold.json text eol=lf
# The native OCR build reads these: the worker embeds the model lock and the notices' SHA256SUMS
# (include_str!) and compares the sums with the engine Containerfile's pin, and the Windows job's
# shell steps read the lock line by line, where a carriage return would be part of a hash.
ocr/engines/tesseract/models.lock text eol=lf
ocr/engines/tesseract/Containerfile text eol=lf
ocr/models/chr-phoenix/SHA256SUMS text eol=lf
boinc/apps/native/*.lock text eol=lf
