// The Quickwit searcher, the sidecar in ca-usnm or its own app
// usnm-search-ca (#267), newest first: its warning and error lines
// counted by level and module (Quickwit's own messages can echo a search's
// query, so only where they came from is shown, never their text, 09
// §9.4.2), and the platform's events for the apps' replicas from
// ContainerAppSystemLogs (restarts, OOM kills, probe failures). The API's
// side of a failed search, with its classified cause, is in api-errors.
// Lines that could carry the managed identity endpoint's secret are dropped.
let searcher = ContainerAppConsoleLogs
    | where ContainerName == "quickwit"
    | where Log !has "IDENTITY_HEADER" and Log !has "MSI_SECRET"
    | extend Line = replace_regex(Log, @"\x1b\[[0-9;]*m", "")
    | extend Level = extract(@"\b(WARN|ERROR)\b", 1, Line)
    | where isnotempty(Level)
    // The target is the first Rust path (a::b) followed by ": ", after any
    // span context: "ERROR merge{…}:merge_executor: quickwit_indexing::
    // actors::merge_executor: message" is quickwit_indexing::actors::merge_executor.
    | extend Module = coalesce(
        extract(@"\b(?:WARN|ERROR)\b.*?\b([a-z_][a-z0-9_]*(?:::[a-z0-9_]+)+): ", 1, Line),
        "(no target)")
    | summarize Count = count(), First = min(TimeGenerated), Last = max(TimeGenerated)
        by Detail = strcat(Level, " ", Module), Replica = ContainerGroupName
    | extend Source = "quickwit";
let platform = ContainerAppSystemLogs
    // Both name forms (ADR-0017): ca-usnm-{env} and usnm-api-ca-{env} for
    // the API, usnm-search-ca-{env} for the searcher's own app.
    | where ContainerAppName == "ca-usnm" or ContainerAppName startswith "ca-usnm-"
        or ContainerAppName matches regex @"^usnm-(api|search)-ca-"
    | where Log !has "IDENTITY_HEADER" and Log !has "MSI_SECRET"
    | where Type != "Normal"
        or Reason has_any ("OOM", "Kill", "BackOff", "Restart", "Unhealthy", "Fail", "Terminat", "Probe")
        or Log has_any ("OOMKilled", "exit code", "restart", "probe failed", "Killing")
    | summarize Count = count(), First = min(TimeGenerated), Last = max(TimeGenerated)
        by Detail = substring(strcat(Reason, ": ", Log), 0, 300), Replica = ReplicaName
    | extend Source = "platform";
union searcher, platform
| project Last, First, Source, Count, Detail, Replica
| order by Last desc
